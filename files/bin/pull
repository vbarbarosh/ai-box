#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

# Brings in what origin has on the branch the box was started on. The box
# holds no key and cannot write .git: the host fetches and merges, through the
# socket bin/run mounts with GIT=commit. A conflict undoes the merge and stops
# with exit 2: the author decides how to resolve it, not the agent.

sock=/run/git/pull.sock

if test $# -gt 0; then
    echo "$scriptname: takes no arguments; it pulls $(cat /run/git/branch 2>/dev/null || echo 'the branch the box was started on') from origin" >&2
    exit 1
fi

if ! test -S "$sock"; then
    echo "$scriptname: not available in this box; on the host, start it with GIT=commit bin/run" >&2
    exit 1
fi

# The host ends with a line of its own carrying git's exit status. No such
# line means the relay went away mid-pull: a failure.
status=
while IFS= read -r line || test -n "$line"; do
    case "$line" in
        "pull: exit "*) status=${line#"pull: exit "} ;;
        *) printf '%s\n' "$line" ;;
    esac
done < <(socat -t 3600 -u "UNIX-CONNECT:$sock" STDOUT)
if test -z "$status"; then
    echo "$scriptname: the host did not finish; check git status before trying again" >&2
    exit 1
fi
exit "$status"
