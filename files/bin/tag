#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

# A tag on the commit the branch is at. .git is read-only in the box: the host
# makes the tag, as its own user, through the socket bin/run mounts with
# GIT=commit. A name that is taken is refused: no tag is moved or deleted.
# `push` then sends the tags made here to origin, with the branch.

sock=/run/git/tag.sock

usage_print () {
    echo "usage: $scriptname <name>                 a tag on the commit the branch is at"
    echo "       $scriptname -m <message> <name>    an annotated one; -m again adds a paragraph"
    echo "The host makes it; push sends it to origin. A GIT=commit box only."
}

message=
names=()
while test $# -gt 0; do
    case "$1" in
        -m)
            test $# -ge 2 || { usage_print >&2; exit 1; }
            message="${message:+$message$'\n\n'}$2"
            shift 2 ;;
        -h|--help) usage_print; exit 0 ;;
        -*) echo "$scriptname: unknown option $1" >&2; usage_print >&2; exit 1 ;;
        *) names+=("$1"); shift ;;
    esac
done
if test "${#names[@]}" -ne 1; then
    usage_print >&2
    exit 1
fi

if ! test -S "$sock"; then
    echo "$scriptname: you have no commit access in this box" >&2
    exit 1
fi

# The host ends with a line of its own carrying git's exit status. No such
# line means the relay went away: a failure.
status=
while IFS= read -r line || test -n "$line"; do
    case "$line" in
        "tag: exit "*) status=${line#"tag: exit "} ;;
        *) printf '%s\n' "$line" ;;
    esac
done < <(printf '%s\0%s' "${names[0]}" "$message" | socat -t 3600 - "UNIX-CONNECT:$sock")
if test -z "$status"; then
    echo "$scriptname: the host did not finish; look at git tag before trying again" >&2
    exit 1
fi
exit "$status"
