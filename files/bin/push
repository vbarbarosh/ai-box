#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

# Pushes the branch the box was started on, to origin. The box holds no key:
# the host runs the push, through the socket bin/run mounts with GIT=commit.
# It takes no arguments, and the host would read none.

sock=/run/git/push.sock

if test $# -gt 0; then
    echo "$scriptname: takes no arguments; it pushes $(cat /run/git/branch 2>/dev/null || echo 'the branch the box was started on') to origin" >&2
    exit 1
fi

if ! test -S "$sock"; then
    echo "$scriptname: you have no commit access in this box" >&2
    exit 1
fi

# The host ends with a line of its own carrying git's exit status. No such
# line means the relay went away mid-push: a failure.
status=
while IFS= read -r line || test -n "$line"; do
    case "$line" in
        "push: exit "*) status=${line#"push: exit "} ;;
        *) printf '%s\n' "$line" ;;
    esac
done < <(socat -t 3600 -u "UNIX-CONNECT:$sock" STDOUT)
if test -z "$status"; then
    echo "$scriptname: the host did not finish; the push may or may not have happened" >&2
    exit 1
fi
exit "$status"
