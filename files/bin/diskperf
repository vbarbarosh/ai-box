#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

case "${1:-}" in
    "") ;;
    -h|--help)
        echo "usage: $scriptname"
        echo "Measures the disk under the current folder: writes a test file there,"
        echo "400 MB of zeros and then 400 MB of random bytes, 10 seconds each at"
        echo "most, prints the speed of each and removes the file."
        exit 0 ;;
    *)
        echo "usage: $scriptname   (no arguments; -h says what it does)" >&2
        exit 1 ;;
esac

# The test file sits in $PWD, so df and dd measure the same disk; its own name,
# so no file of yours is overwritten.
tmpfile=`mktemp -p $PWD .diskperf.XXXXXXXXXX`
trap 'rm -f $tmpfile' EXIT

cat << EOF
Disk Performance:

$(df $PWD -h)
    /dev/zero     $(timeout 10s bash -c 'dd if=/dev/zero of="$1" bs=4K count=100K 2>&1 | tail -n1; rm -f "$1"; sync' _ $tmpfile)
    /dev/urandom  $(timeout 10s bash -c 'dd if=/dev/urandom of="$1" bs=4K count=100K 2>&1 | tail -n1; rm -f "$1"; sync' _ $tmpfile)

EOF
