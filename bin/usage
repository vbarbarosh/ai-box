#!/usr/bin/env node

const fs = require('node:fs');
const https = require('node:https');
const path = require('node:path');

/*
 * Rate-limit usage of the two agents the box logs in to, side by side.
 *
 * The logins live in this repo, under data/ -- the host side of the mounts
 * bin/run makes (data/claude is ~/.claude inside the box, data/codex is
 * ~/.codex). Anchored to the script, not to $PWD, like the rest of bin/.
 * Nothing is started to read them: they are plain files here.
 *
 * The tokens are the ones the agents refresh themselves; an expired one
 * means the box has not been opened for a while, and one run of the agent
 * inside it brings the token back.
 */
const DATA_DIR = path.join(path.dirname(__dirname), 'data');
const USAGE_CONFIG = {
    claude_credentials_file: path.join(DATA_DIR, 'claude', '.credentials.json'),
    codex_auth_file: path.join(DATA_DIR, 'codex', 'auth.json'),
    display_time_zone: 'Europe/Chisinau',
    bar_width: 30,
    error_width: 46,
};
const USAGE_COLUMN_GAP = '   │   ';
const USAGE = [
    'usage: usage',
    'Prints the rate-limit usage of the agents the box is logged in to, Claude and',
    'GPT side by side; reads their logins in data/, starts nothing.',
].join('\n');

cli(main);

async function main()
{
    if (['-h', '--help'].includes(process.argv[2])) {
        console.log(USAGE);
        return;
    }

    // Each agent's login is read inside its own fetch: signed in to one
    // agent only, that column shows, and the other says what is missing.
    const usage_results = await Promise.allSettled([
        usage_fetch_with_logs('Claude', '🟠', () => claude_usage_fetch(claude_credentials_load().access_token)),
        usage_fetch_with_logs('GPT', '🟢', function () {
            const credentials = gpt_credentials_load();
            return gpt_usage_fetch(credentials.access_token, credentials.account_id);
        }),
    ]);
    const claude_result = usage_results[0];
    const gpt_result = usage_results[1];
    console.log('\n📋 Usage data ready. Building table...\n');
    const claude_blocks = (claude_result.status === 'fulfilled')
        ? usage_blocks_from_claude_usage(claude_result.value)
        : usage_error_blocks_from_reason('Claude', 'claude', claude_result.reason);
    const gpt_blocks = (gpt_result.status === 'fulfilled')
        ? usage_blocks_from_gpt_usage(gpt_result.value)
        : usage_error_blocks_from_reason('GPT', 'codex', gpt_result.reason);

    usage_columns_print(claude_blocks, gpt_blocks);
    if ((claude_result.status === 'rejected') || (gpt_result.status === 'rejected')) {
        process.exitCode = 1;
    }
}

async function usage_fetch_with_logs(provider, emoji, fetch_usage)
{
    console.log(`${emoji} Fetching ${provider} usage...`);
    try {
        const usage = await fetch_usage();
        console.log(`✅ ${provider} usage fetched.`);
        return usage;
    }
    catch (error) {
        console.log(`❌ ${provider} usage fetch failed.`);
        throw error;
    }
}

function usage_json_file_load(filename, agent)
{
    let contents;
    try {
        contents = fs.readFileSync(filename, 'utf8');
    }
    catch (error) {
        if (error.code === 'ENOENT') {
            const login_error = new Error(`No ${agent} login yet.`);
            login_error.hints = [`${format_data_path(filename)} is missing;`, `\`bin/run ${agent}\` and log in.`];
            throw login_error;
        }
        throw new Error(`Could not read ${format_data_path(filename)}: ${error.message}`);
    }

    try {
        return JSON.parse(contents);
    }
    catch (error) {
        throw new Error(`Could not parse ${format_data_path(filename)}: ${error.message}`);
    }
}

// A file of data/ as the author knows it: from the checkout, not from the root.
function format_data_path(filename)
{
    return path.relative(path.dirname(DATA_DIR), filename);
}

function claude_credentials_load()
{
    const claude_credentials = usage_json_file_load(USAGE_CONFIG.claude_credentials_file, 'claude');
    const out = {access_token: claude_credentials.claudeAiOauth?.accessToken};
    if (!out.access_token) {
        throw new Error(`Missing claudeAiOauth.accessToken in ${format_data_path(USAGE_CONFIG.claude_credentials_file)}.`);
    }
    return out;
}

function gpt_credentials_load()
{
    const codex_auth = usage_json_file_load(USAGE_CONFIG.codex_auth_file, 'codex');
    const out = {access_token: codex_auth.tokens?.access_token, account_id: codex_auth.tokens?.account_id};
    if (!out.access_token) {
        throw new Error(`Missing tokens.access_token in ${format_data_path(USAGE_CONFIG.codex_auth_file)}.`);
    }
    if (!out.account_id) {
        throw new Error(`Missing tokens.account_id in ${format_data_path(USAGE_CONFIG.codex_auth_file)}.`);
    }
    return out;
}

function usage_request_json(hostname, path, headers)
{
    return new Promise(function (resolve, reject) {
        const request = https.get({hostname, path, headers, timeout: 30_000}, function (response) {
            let body = '';
            response.setEncoding('utf8');
            response.on('data', function (chunk) {
                body += chunk;
            });
            response.on('end', function () {
                let json;
                try {
                    json = body ? JSON.parse(body) : {};
                }
                catch {
                    const http_error = new Error(`HTTP ${response.statusCode} returned invalid JSON.`);
                    http_error.statusCode = response.statusCode;
                    reject(http_error);
                    return;
                }

                if ((response.statusCode < 200) || (response.statusCode >= 300)) {
                    const message = json.error?.message
                        || json.detail
                        || json.message
                        || JSON.stringify(json);
                    const http_error = new Error(`HTTP ${response.statusCode}: ${message}`);
                    http_error.statusCode = response.statusCode;
                    reject(http_error);
                    return;
                }
                resolve(json);
            });
        });

        request.on('timeout', function () {
            request.destroy(new Error('Request timed out.'));
        });
        request.on('error', reject);
    });
}

function claude_usage_fetch(access_token)
{
    return usage_request_json('api.anthropic.com', '/api/oauth/usage', {
        accept: 'application/json',
        authorization: `Bearer ${access_token}`,
        'anthropic-beta': 'oauth-2025-04-20',
        'user-agent': 'combined-usage/1.0.0',
    });
}

async function gpt_usage_fetch(access_token, account_id)
{
    let last_error;

    const api_paths = ['/backend-api/wham/usage', '/backend-api/codex/usage'];
    for (const api_path of api_paths) {
        try {
            return await usage_request_json('chatgpt.com', api_path, {
                accept: 'application/json',
                authorization: `Bearer ${access_token}`,
                'chatgpt-account-id': account_id,
                'user-agent': 'codex-cli',
            });
        }
        catch (error) {
            last_error = error;
            if (error.statusCode !== 404) {
                throw error;
            }
        }
    }
    throw last_error;
}

function format_percent(value)
{
    const number = Number(value);
    if (!Number.isFinite(number)) {
        return 'unknown';
    }
    return `${number.toFixed(1).replace(/\.0$/, '')}%`;
}

function format_usage_bar(value)
{
    const number = Number(value);
    const percent = Number.isFinite(number) ? Math.min(100, Math.max(0, number)) : 0;
    const filled = Math.round(percent/100*USAGE_CONFIG.bar_width);
    return `[${'█'.repeat(filled)}${'░'.repeat(USAGE_CONFIG.bar_width - filled)}]`;
}

function format_reset(value)
{
    if (!value) {
        return 'starts when a message is sent';
    }

    const numeric = Number(value);
    const milliseconds = Number.isFinite(numeric) ? numeric*1000 : new Date(value).getTime();
    if (!Number.isFinite(milliseconds)) {
        return String(value);
    }

    // The zone's own offset on that date, GMT+3 in summer and GMT+2 in winter.
    const date_format = new Intl.DateTimeFormat('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
        timeZone: USAGE_CONFIG.display_time_zone,
        timeZoneName: 'short',
    });
    return date_format.format(new Date(milliseconds));
}

function format_claude_limit_label(limit)
{
    if (limit.kind === 'session') {
        return 'Current session';
    }
    if (limit.kind === 'weekly_all') {
        return 'All models';
    }
    return limit.scope?.model?.display_name
        || limit.scope?.surface?.display_name
        || limit.kind.replaceAll('_', ' ');
}

function format_money(value)
{
    if (!value || (typeof value.amount_minor !== 'number')) {
        return null;
    }
    const exponent = Number.isInteger(value.exponent) ? value.exponent : 2;
    const number_format = new Intl.NumberFormat('en-US', {style: 'currency', currency: value.currency || 'USD'});
    return number_format.format(value.amount_minor/10**exponent);
}

function format_usd(value)
{
    return `$${value.toFixed(2)}`;
}

function format_title_case(value)
{
    return String(value || 'Additional limit').replace(/[_-]+/g, ' ').replace(/\b\w/g, v => v.toUpperCase());
}

function format_string_padded(value, width)
{
    const padding = Math.max(0, width - visible_length_of(value));
    return `${value}${' '.repeat(padding)}`;
}

function usage_meter_block_from_values(label, percent, reset_at)
{
    return [
        label,
        `${format_usage_bar(percent)}  ${format_percent(percent)} used`,
        `Resets: ${format_reset(reset_at)}`,
    ];
}

// The older answer: a limit under each key, null where the account has none.
// A model's weekly limit is seven_day_<model>, whichever models the service
// names: Opus and Sonnet once, Fable now.
function legacy_claude_limits_from_usage(usage)
{
    const out = [];
    const pairs = [
        ['Current session', usage.five_hour],
        ['All models', usage.seven_day],
    ];
    for (const key of Object.keys(usage)) {
        const model = key.match(/^seven_day_(.+)$/)?.[1];
        if (model && (usage[key]?.utilization !== undefined)) {
            pairs.push([format_title_case(model), usage[key]]);
        }
    }
    for (const pair of pairs) {
        const label = pair[0];
        const limit = pair[1];
        if (limit) {
            out.push({label, percent: limit.utilization, resets_at: limit.resets_at});
        }
    }
    return out;
}

function usage_blocks_from_claude_usage(usage)
{
    const out = [];
    const limits = (Array.isArray(usage.limits) && usage.limits.length)
        ? usage.limits
        : legacy_claude_limits_from_usage(usage);
    for (const limit of limits) {
        const label = limit.label || format_claude_limit_label(limit);
        const percent = limit.percent ?? limit.utilization;
        out.push(usage_meter_block_from_values(label, percent, limit.resets_at));
    }

    if (usage.spend) {
        const block = [`Usage credits: ${usage.spend.enabled ? 'enabled' : 'disabled'}`];
        const used = format_money(usage.spend.used);
        const limit = format_money(usage.spend.limit);
        if (used) {
            block.push(`Credits used: ${used}${limit ? ` of ${limit}` : ''}`);
        }
        out.push(block);
    }
    else if (usage.extra_usage) {
        out.push([`Usage credits: ${usage.extra_usage.is_enabled ? 'enabled' : 'disabled'}`]);
    }
    return out;
}

function weekly_window_from_rate_limit(rate_limit)
{
    const windows = [rate_limit?.primary_window, rate_limit?.secondary_window];
    const windows_filtered = windows.filter(Boolean);
    const windows_sorted_by_seconds = windows_filtered.sort(function (a, b) {
        return Number(b.limit_window_seconds || 0) - Number(a.limit_window_seconds || 0);
    });
    return windows_sorted_by_seconds[0] || null;
}

function usage_blocks_from_gpt_usage(usage)
{
    const out = [];

    const current_session = usage.rate_limit?.primary_window;
    if (current_session) {
        out.push(usage_meter_block_from_values(
            'Current session',
            current_session.used_percent,
            current_session.reset_at,
        ));
    }

    const all_models = usage.rate_limit?.secondary_window;
    if (all_models) {
        out.push(usage_meter_block_from_values(
            'All models',
            all_models.used_percent,
            all_models.reset_at,
        ));
    }

    for (const additional_rate_limit of usage.additional_rate_limits || []) {
        const weekly_window = weekly_window_from_rate_limit(additional_rate_limit.rate_limit);
        if (weekly_window) {
            const label = format_title_case(additional_rate_limit.limit_name || additional_rate_limit.metered_feature);
            out.push(usage_meter_block_from_values(label, weekly_window.used_percent, weekly_window.reset_at));
        }
    }

    const spend_limit = usage.spend_control?.individual_limit;
    if (spend_limit) {
        const percent = spend_limit.used_percent ?? (100 - Number(spend_limit.remaining_percent));
        out.push(usage_meter_block_from_values('Spend control', percent, spend_limit.reset_at));
    }

    const balance = Number(usage.credits?.balance || 0);
    const credits_enabled = Boolean(usage.credits?.unlimited || usage.credits?.has_credits || (balance > 0));
    const credits_block = [`Usage credits: ${credits_enabled ? 'enabled' : 'disabled'}`];
    if (!credits_enabled) {
        credits_block.push('Credits used: $0.00');
    }
    else if (usage.credits?.unlimited) {
        credits_block.push('Credit balance: unlimited');
    }
    else {
        credits_block.push(`Credit balance: ${format_usd(balance)}`);
    }
    out.push(credits_block);
    return out;
}

function key_from_usage_block(block)
{
    const heading = block[0] || '';
    if (heading.startsWith('Usage credits:')) {
        return 'Usage credits';
    }
    return heading;
}

function usage_blocks_align(left_blocks, right_blocks)
{
    // An error is its whole column: it stands at the top, beside the other
    // column's first block, not under its last one.
    if ((left_blocks[0]?.[0] === 'Error') || (right_blocks[0]?.[0] === 'Error')) {
        const out = [];
        for (let i = 0, end = Math.max(left_blocks.length, right_blocks.length); i < end; ++i) {
            out.push([left_blocks[i] || [], right_blocks[i] || []]);
        }
        return out;
    }

    const scores = [];
    for (let i = 0, end = left_blocks.length + 1; i < end; ++i) {
        scores.push(Array(right_blocks.length + 1).fill(0));
    }

    for (let i = left_blocks.length - 1; i >= 0; --i) {
        for (let j = right_blocks.length - 1; j >= 0; --j) {
            const keys_match = key_from_usage_block(left_blocks[i])
                === key_from_usage_block(right_blocks[j]);
            scores[i][j] = keys_match
                ? scores[i + 1][j + 1] + 1
                : Math.max(scores[i + 1][j], scores[i][j + 1]);
        }
    }

    let i = 0;
    let j = 0;

    const out = [];
    while ((i < left_blocks.length) || (j < right_blocks.length)) {
        const keys_match = (i < left_blocks.length)
            && (j < right_blocks.length)
            && (key_from_usage_block(left_blocks[i]) === key_from_usage_block(right_blocks[j]));
        if (keys_match) {
            out.push([left_blocks[i], right_blocks[j]]);
            ++i;
            ++j;
        }
        else if (
            (i < left_blocks.length)
            && ((j >= right_blocks.length) || (scores[i + 1][j] >= scores[i][j + 1]))
        ) {
            out.push([left_blocks[i], []]);
            ++i;
        }
        else {
            out.push([[], right_blocks[j]]);
            ++j;
        }
    }
    return out;
}

function visible_length_of(value)
{
    const value_without_ansi = value.replace(/\x1B\[[0-?]*[ -/]*[@-~]/g, '');
    return [...value_without_ansi].length;
}

// A message as lines no wider than width: broken between words, and inside
// a word longer than a line. A message may hold line breaks of its own, as
// JSON.parse's does; they are spaces here.
function lines_from_text_wrapped(text, width)
{
    const out = [];
    const words = String(text).split(/\s+/).filter(Boolean);
    const pieces = words.flatMap(v => v.match(new RegExp(`.{1,${width}}`, 'gu')));
    for (const piece of pieces) {
        const last = out[out.length - 1];
        if ((out.length > 0) && ([...last].length + 1 + [...piece].length <= width)) {
            out[out.length - 1] = `${last} ${piece}`;
        }
        else {
            out.push(piece);
        }
    }
    return out;
}

function usage_error_blocks_from_reason(provider, agent, reason)
{
    const message_lines = lines_from_text_wrapped(reason.message, USAGE_CONFIG.error_width);
    const out = [['Error', ...message_lines, ...(reason.hints || [])]];
    if (reason.statusCode === 401) {
        out[0].push(`${provider} access token is invalid or expired;`);
        out[0].push(`\`bin/run ${agent}\` refreshes it.`);
    }
    return out;
}

function usage_columns_print(claude_blocks, gpt_blocks)
{
    let width = 6;

    const all_lines = [...claude_blocks.flat(), ...gpt_blocks.flat()];
    for (const line of all_lines) {
        width = Math.max(width, visible_length_of(line));
    }

    console.log(`${format_string_padded('CLAUDE', width)}${USAGE_COLUMN_GAP}GPT`);
    console.log(`${'─'.repeat(width)}${USAGE_COLUMN_GAP}${'─'.repeat(width)}`);

    const aligned_blocks = usage_blocks_align(claude_blocks, gpt_blocks);
    for (let i = 0, ii = aligned_blocks.length; i < ii; ++i) {
        const pair = aligned_blocks[i];
        const left_block = pair[0];
        const right_block = pair[1];
        const height = Math.max(left_block.length, right_block.length);
        for (let j = 0; j < height; ++j) {
            const left_line = left_block[j] || '';
            const right_line = right_block[j] || '';
            console.log(`${format_string_padded(left_line, width)}${USAGE_COLUMN_GAP}${right_line}`);
        }
        if (i < ii - 1) {
            console.log(`${' '.repeat(width)}${USAGE_COLUMN_GAP}`);
        }
    }
}

/*
 * The process contract of @vbarbarosh/node-helpers/src/cli, kept in the file:
 * bin/ has no package.json and nothing to npm ci, and one helper is not a
 * reason to grow one. Holds the event loop open until main settles, reports a
 * failure and exits non-zero; a synchronous throw inside main is reported the
 * same as a rejection.
 */
function cli(main)
{
    const timer = setInterval(v => v, 1E9);
    // Not Promise.try: Node has it from 23 on, and Ubuntu 24.04's own is 18.
    Promise.resolve().then(main).then(resolve, reject);

    function resolve() {
        clearInterval(timer);
    }
    function reject(error) {
        clearInterval(timer);
        console.error(`Could not display usage: ${error.message}`);
        process.exit(1);
    }
}
