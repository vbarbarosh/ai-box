#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

BLACK="\e[30m" RED="\e[31m" GREEN="\e[32m" YELLOW="\e[33m" BLUE="\e[34m"
PURPLE="\e[35m" CYAN="\e[36m" WHITE="\e[37m" RESET="\e[0m"

# Reports what the host has and what it lacks. Exits non-zero if anything
# required is missing, so it can gate a build in CI. `bin/configure` installs
# whatever this reports.
#
#   bin/self-check            checks the host
#   bin/self-check --deep     also starts the box and runs a container inside it
#   bin/self-check --versions also lists what the image was built with

usage_print () {
    echo "usage: $scriptname              report what the host has and lacks"
    echo "       $scriptname --deep       also start boxes: a container inside one, and the boundary"
    echo "       $scriptname --versions   also list what the image was built with"
    echo "Exits non-zero when a required item is missing."
}

deep=
versions=
for arg in "$@"; do
    case "$arg" in
        --deep)     deep=1 ;;
        --versions) versions=1 ;;
        -h|--help)  usage_print; exit 0 ;;
        *) usage_print >&2; exit 1 ;;
    esac
done

EXIT_MESSAGE="${RED}bin/self-check failed${RESET}"
trap 'echo -e "$EXIT_MESSAGE"' EXIT

if test -t 1; then
    green=$'\e[32m'; red=$'\e[31m'; yellow=$'\e[33m'; dim=$'\e[2m'; reset=$'\e[0m'
else
    green=; red=; yellow=; dim=; reset=
fi

# The same path bin/run uses: everything the box keeps between runs lives in
# this repo, under data/. Shortened for display when it sits under $HOME.
data="$(dirname "$scriptdir")/data"
short="${data/#$HOME/\~}"

missing_required=0
missing_optional=0

format_bytes () {
    awk -v b="$1" 'BEGIN {
        split("B KB MB GB TB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf "%.1f %s", b, u[i]
    }'
}

# ok_report <label> <detail>
ok_report () {
    printf '  %s%-9s%s %-26s %s\n' "$green" ok "$reset" "$1" "${2-}"
}

# missing_report <required|optional> <label> <how to fix>
missing_report () {
    if test "$1" = required; then
        missing_required=$((missing_required + 1))
        printf '  %s%-9s%s %-26s %s%s%s\n' "$red" MISSING "$reset" "$2" "$dim" "${3-}" "$reset"
    else
        missing_optional=$((missing_optional + 1))
        printf '  %s%-9s%s %-26s %s%s%s\n' "$yellow" absent "$reset" "$2" "$dim" "${3-}" "$reset"
    fi
}

# check_binary <binary> <label> <package>
check_binary () {
    if command -v "$1" >/dev/null 2>&1; then
        version_line=$($1 --version 2>/dev/null | head -1 | cut -c1-40 || true)
        ok_report "$2" "${version_line:-present at $(command -v "$1")}"
    else
        missing_report required "$2" "bin/configure  (apt: $3)"
    fi
}

echo
echo "host tools"
check_binary podman    podman    podman
# bin/run's --userns=keep-id:uid=1000,gid=1000 needs 4.3; Ubuntu 22.04 has 3.4.4.
podman_have=$(podman --version 2>/dev/null | awk '{print $3}' || true)
if test -n "$podman_have" && dpkg --compare-versions "$podman_have" lt 4.3 2>/dev/null; then
    missing_report required "podman 4.3" "$podman_have here; upgrade to Ubuntu 24.04"
fi
check_binary crun      crun      crun
check_binary newuidmap newuidmap uidmap

# bin/run puts it at PID 1 of the box (--init) whenever it is here; without it
# the box still runs, with bash reaping nothing.
if test -x /usr/libexec/podman/catatonit || command -v catatonit >/dev/null 2>&1; then
    ok_report "catatonit" "init for the box"
else
    missing_report optional "catatonit" "bin/configure  (apt: catatonit)"
fi

# The relays `commit`, `tag`, `push` and `pull` inside a GIT=commit box talk to;
# without it bin/run refuses GIT=commit.
if command -v socat >/dev/null 2>&1; then
    ok_report "socat" "commit, tag, push, pull: GIT=commit"
else
    missing_report optional "socat" "bin/configure  (apt: socat)"
fi

# What those relays run on the host; without it bin/run refuses GIT=commit.
if command -v git >/dev/null 2>&1; then
    ok_report "git" "$(git --version 2>/dev/null | head -1 | cut -c1-40)"
else
    missing_report optional "git" "bin/configure  (apt: git)"
fi

# bin/usage is the one host command written in node; nothing else needs it.
if command -v node >/dev/null 2>&1; then
    ok_report "node" "$(node --version 2>/dev/null | head -1 | cut -c1-20): bin/usage"
else
    missing_report optional "node" "apt: nodejs  (only bin/usage needs it)"
fi

if command -v pasta >/dev/null 2>&1; then
    ok_report "pasta" "$(pasta --version 2>/dev/null | head -1 | cut -c1-40)"
elif command -v slirp4netns >/dev/null 2>&1; then
    ok_report "slirp4netns" "$(slirp4netns --version 2>/dev/null | head -1 | cut -c1-40)"
else
    missing_report required "pasta/slirp4netns" "bin/configure  (apt: passt)"
fi

echo
echo "kernel"
if test -c /dev/fuse; then
    ok_report "/dev/fuse" "inner overlay driver"
else
    missing_report required "/dev/fuse" "modprobe fuse"
fi

if test -c /dev/net/tun; then
    ok_report "/dev/net/tun" "inner network uplink"
else
    missing_report required "/dev/net/tun" "modprobe tun"
fi

if test "$(stat -fc %T /sys/fs/cgroup)" = cgroup2fs; then
    ok_report "cgroup v2" ""
else
    missing_report required "cgroup v2" "boot with systemd.unified_cgroup_hierarchy=1"
fi

userns=$(cat /proc/sys/user/max_user_namespaces 2>/dev/null || echo 0)
if test "$userns" -gt 0; then
    ok_report "user namespaces" "max $userns"
else
    missing_report required "user namespaces" "sysctl user.max_user_namespaces=15000"
fi

# bin/run limits the box (--pids-limit, --memory, --cpus) only through the
# controllers systemd delegates to this session. Missing ones mean the box
# runs uncapped, not that it fails.
controllers=$(cat "/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers" 2>/dev/null || true)
controllers_delegated=; controllers_missing=
for controller in pids memory cpu; do
    case " $controllers " in
        *" $controller "*) controllers_delegated="$controllers_delegated $controller" ;;
        *)                 controllers_missing="$controllers_missing $controller" ;;
    esac
done
if test -z "$controllers_missing"; then
    ok_report "cgroup delegation" "pids memory cpu"
elif test -n "$controllers_delegated"; then
    missing_report optional "cgroup delegation" "have${controllers_delegated}; box runs without${controllers_missing} limit"
else
    missing_report optional "cgroup delegation" "none; box runs with no limits (needs a systemd user session)"
fi

echo
# Under sudo, id -un is root; report on the user who will run the box.
me=${SUDO_USER:-$(id -un)}
echo "subordinate ids for $me"
if test "$(id -u)" -eq 0 && test -z "${SUDO_USER-}"; then
    echo "  ${dim}(running as bare root -- this reports root's range, which is${reset}"
    echo "  ${dim} probably not the user who will run the box)${reset}"
fi
# The inner engine carves its own range out of this one, so a short range is
# the setting that breaks nesting with an opaque newuidmap error.
for subid_file in /etc/subuid /etc/subgid; do
    ids_count=$(awk -F: -v u="$me" '$1==u {print $3; exit}' "$subid_file" 2>/dev/null || true)
    if test "${ids_count:-0}" -ge 65536 2>/dev/null; then
        ok_report "$subid_file" "$ids_count ids"
    else
        missing_report required "$subid_file" "bin/configure  (have ${ids_count:-0}, need 65536)"
    fi
done

echo
echo "host storage"
# bin/run maps your uid into the box (--userns=keep-id). How podman does that
# depends on the graph driver, and the fast path is not the obvious one:
#
#   native overlay -> an ID-shifted COPY of every layer, the first time a
#       given image id is mapped: after any non-cached build. Minutes on an
#       image this size. Measured on podman 5.7 -- the idmapped-lower-layer
#       fast path does not avoid it, so this is the normal path, not an old
#       containers/storage misbehaving.
#   fuse-overlayfs -> no copy, but it breaks nested `docker build` against
#       the shared image store, so it is not a workaround.
#
# bin/build warms this so it never lands on whoever runs bin/run, so this is
# reported, not treated as a fault.
driver=$(podman info --format '{{.Store.GraphDriverName}}' 2>/dev/null || echo unknown)
native=$(podman info --format '{{index .Store.GraphStatus "Native Overlay Diff"}}' 2>/dev/null || echo "")
if test "$driver" = overlay && test "$native" = true; then
    ok_report "graph driver" "native overlay (podman $(podman --version 2>/dev/null | awk '{print $3}'))"
    printf '  %s%-9s%s %-26s %s%s%s\n' "$dim" "" "$reset" "" "$dim" \
        "if bin/build's warming step is slow, that is the layer copy; it" "$reset"
    printf '  %s%-9s%s %-26s %s%s%s\n' "$dim" "" "$reset" "" "$dim" \
        "runs after any non-cached build; fuse-overlayfs is not a fix" "$reset"
elif test "$driver" = unknown; then
    missing_report optional "graph driver" "podman did not say"
else
    ok_report "graph driver" "$driver${native:+ (native diff: $native)}"
fi

echo
echo "image"
if podman image exists ai-box 2>/dev/null; then
    ok_report "ai-box" "$(format_bytes "$(podman image inspect ai-box --format '{{.Size}}' 2>/dev/null || echo 0)")"
    # What the build resolved: every component the Dockerfile fetches at its
    # current version is recorded there, one name=version per line. No
    # --userns here, so this never triggers the id-mapped layer copy; and no
    # log on the host, as in bin/run.
    manifest=$(podman run --rm --pull=never --log-driver=none --entrypoint cat ai-box /etc/ai-box/versions 2>/dev/null || true)
    if test -n "$manifest"; then
        if test -n "$versions"; then
            echo "$manifest" | sed "s/^/  ${dim}          /; s/\$/${reset}/"
        else
            ok_report "versions" "$(echo "$manifest" | wc -l) recorded (--versions to list)"
        fi
    fi
else
    missing_report optional "ai-box" "bin/build"
fi

# What the image leaves out -- browsers, whisper model, Chrome, agent CLIs --
# is in data/extras, with its own versions file in the same format.
if test -f "$data/extras/versions"; then
    if test -n "$versions"; then
        ok_report "extras" "$short/extras, $(du -sh "$data/extras" 2>/dev/null | cut -f1)"
        sed "s/^/  ${dim}          /; s/\$/${reset}/" "$data/extras/versions"
    else
        ok_report "extras" "$short/extras, $(wc -l < "$data/extras/versions") recorded"
    fi
else
    missing_report optional "extras" "bin/build; bin/run needs it"
fi

if test -d "$data/images"; then
    ok_report "shared image store" "$(podman --root "$data/images" --storage-driver overlay images -q 2>/dev/null | wc -l) images"
else
    missing_report optional "shared image store" "podman --root $short/images pull alpine:latest"
fi

echo
# Agent state, all under $short, undotted here and dotted inside the box.
# Named by leaf so the columns stay aligned.
echo "mounts bin/run will make ${dim}(box state under $short)${reset}"
if test -d "$data/claude";      then ok_report "claude"      "agent state, rw";   else missing_report optional "claude"      "created on first run"; fi
if test -f "$data/claude.json"; then ok_report "claude.json" "agent config, rw";  else missing_report optional "claude.json" "created on first run"; fi
if test -d "$data/codex";       then ok_report "codex"       "agent state, rw";   else missing_report optional "codex"       "created on first run"; fi
if test -f "$data/codex.json";  then ok_report "codex.json"  "agent config, rw";  else missing_report optional "codex.json"  "created on first run"; fi
repos_pick=()
if test -n "${REPOS_PICK+set}"; then
    read -r -d '' -a repos_pick <<<"$REPOS_PICK" || true
fi
# shellcheck disable=SC2088  # the tilde is a label, not a path
if test -n "${REPOS_PICK+set}" && test "${#repos_pick[@]}" = 0; then
    ok_report 'REPOS_PICK'  "empty: no /repos"
elif test -z "${REPOS+set}"; then
    if test -d "$HOME/repos";    then ok_report '~/repos'      "/repos, read-only"; else missing_report optional '~/repos'      "mkdir it, or set REPOS, to mount it"; fi
elif test -z "$REPOS"; then
    ok_report 'REPOS'       "empty: no /repos"
elif test -d "$REPOS"; then
    ok_report 'REPOS'       "$REPOS as /repos, read-only"
else
    missing_report required 'REPOS'       "not a directory: $REPOS"
fi
if test "${#repos_pick[@]}" -gt 0; then
    ok_report 'REPOS_PICK'  "only ${repos_pick[*]}, each at /repos/<name>"
    repos_folder=${REPOS-$HOME/repos}
    for name in "${repos_pick[@]}"; do
        if test -z "$repos_folder" || ! test -d "$repos_folder/$name"; then
            missing_report optional 'REPOS_PICK'  "no $name in ${repos_folder:-REPOS}, skipped"
        fi
    done
fi
# shellcheck disable=SC2088  # the tilde is a label, not a path
if test -z "${SOCKETS+set}"; then
    if test -d "$HOME/sockets";  then ok_report '~/sockets'    "/sockets, read-only"; else missing_report optional '~/sockets'    "mkdir it, or set SOCKETS, to mount it"; fi
elif test -z "$SOCKETS"; then
    ok_report 'SOCKETS'     "empty: no /sockets"
elif test -d "$SOCKETS"; then
    ok_report 'SOCKETS'     "$SOCKETS as /sockets, read-only"
else
    missing_report required 'SOCKETS'     "not a directory: $SOCKETS"
fi
if test -z "${AGENTS:-}"; then
    ok_report 'AGENTS'      "not set: no /agents"
elif test -d "$AGENTS"; then
    ok_report 'AGENTS'      "$AGENTS as /agents, read-only"
else
    missing_report required 'AGENTS'      "not a directory: $AGENTS"
fi

echo
echo "sign-ins bin/run will pass ${dim}(by name, never written to $short)${reset}"
for name in CLAUDE_CODE_OAUTH_TOKEN CODEX_API_KEY; do
    if test -n "${!name:-}"; then
        ok_report "$name" "set: the box signs in with it"
    else
        ok_report "$name" "not set: the shared sign-in"
    fi
done
if test -n "${OPENAI_API_KEY:-}"; then
    ok_report OPENAI_API_KEY "set: passed in; codex signs in with CODEX_API_KEY"
else
    ok_report OPENAI_API_KEY "not set"
fi

# Stale container records naming a runtime that is no longer installed make
# every podman command noisy. Worth naming, because the error does not say so.
stale=$(podman ps -a 2>&1 >/dev/null | grep -c "is in use by a container, but is not available" || true)
if test "$stale" -gt 0; then
    echo
    echo "warnings"
    printf '  %s%-9s%s %-26s %s%s%s\n' "$yellow" stale "$reset" "container records" \
        "$dim" "runtime missing; install it, then: podman rm -af" "$reset"
fi

if test -n "$deep"; then
    echo
    echo "deep check"
    if podman image exists ai-box 2>/dev/null; then
        # stdin is redirected, so bin/run asks for no tty and the output has
        # no \r\n; the tr stays for a bin/run invoked some other way.
        if nested_line=$("$scriptdir/run" docker run --rm alpine echo nested-ok 2>&1 </dev/null | tr -d '\r' | tail -1) \
            && test "$nested_line" = nested-ok; then
            ok_report "container inside box" "docker run works"
        else
            missing_report required "container inside box" "$nested_line"
        fi

        # Fresh boxes accept explicit credentials but never saved sign-ins or
        # the previous box's files. No real token or model request is needed.
        fresh_ok=1
        for attempt in 1 2; do
            fresh_token=ai-box-self-check
            if test "$attempt" = 2; then
                fresh_token=
            fi
            if ! fresh_line=$(env -u GIT -u REPOS -u REPOS_PICK -u SOCKETS -u AGENTDIR -u AGENTS -u MASK -u READONLY \
                FRESH=1 CODEX_API_KEY="$fresh_token" CODEX_ACCESS_TOKEN=ai-box-self-check \
                OPENAI_API_KEY="$fresh_token" CLAUDE_CODE_OAUTH_TOKEN="$fresh_token" \
                "$scriptdir/run-fresh" bash -seu -- "$fresh_token" 2>&1 <<'EOF'
test "${CODEX_API_KEY:-}" = "$1"
test "${OPENAI_API_KEY:-}" = "$1"
test "${CLAUDE_CODE_OAUTH_TOKEN:-}" = "$1"
test -z "${CODEX_ACCESS_TOKEN:-}"
for path in "$HOME/.codex/auth.json" "$HOME/.codex/config.toml" "$HOME/.claude/.credentials.json" /app/.ai-box-fresh-check; do
    test ! -e "$path"
done
for path in /repos /sockets /agentdir /agents /run/git /var/lib/shared; do
    if mountpoint -q "$path"; then
        exit 1
    fi
done
command -v claude >/dev/null
command -v codex >/dev/null
test "$(findmnt -n -o FSTYPE --target /app)" = tmpfs
touch /app/.ai-box-fresh-check "$HOME/.codex/auth.json"
echo fresh-ok
EOF
            ); then
                fresh_ok=
                break
            fi
            if test "$(echo "$fresh_line" | tr -d '\r' | tail -1)" != fresh-ok; then
                fresh_ok=
                break
            fi
        done
        if test -n "$fresh_ok"; then
            ok_report "fresh boxes" "explicit credentials only, writable /app, no saved state"
        else
            missing_report required "fresh boxes" "$fresh_line"
        fi

        # The checkout is a workspace that would reveal data/ through /app.
        # Podman copies the underlying files into tmpfs unless told not to.
        if fresh_app_line=$(cd "$scriptdir/.." && env -u GIT -u REPOS -u REPOS_PICK -u SOCKETS -u AGENTDIR -u AGENTS -u MASK -u READONLY \
            FRESH=app CODEX_API_KEY=ai-box-self-check OPENAI_API_KEY=ai-box-self-check \
            CLAUDE_CODE_OAUTH_TOKEN=ai-box-self-check "$scriptdir/run" bash -seu 2>&1 <<'EOF'
test "${CODEX_API_KEY:-}" = ai-box-self-check
test "${OPENAI_API_KEY:-}" = ai-box-self-check
test "${CLAUDE_CODE_OAUTH_TOKEN:-}" = ai-box-self-check
for path in "$HOME/.codex/auth.json" "$HOME/.claude/.credentials.json"; do
    test ! -e "$path"
done
mountpoint -q /app/data
test -z "$(ls -A /app/data)"
touch /app/data/.ai-box-fresh-check
echo fresh-app-ok
EOF
        ) && test "$(echo "$fresh_app_line" | tr -d '\r' | tail -1)" = fresh-app-ok \
            && ! test -e "$data/.ai-box-fresh-check"; then
            ok_report "fresh workspace" "checkout data hidden; host state unchanged"
        else
            missing_report required "fresh workspace" "$fresh_app_line"
        fi

        # The host publishes into a protected folder after the box is ready;
        # the same box must see it while still refusing writes of its own.
        readonly_dir=$(mktemp -d)
        mkdir -p "$readonly_dir/note/messages" "$readonly_dir/note/markers" "$readonly_dir/workspace/reference"
        ln -s "$readonly_dir/note" "$readonly_dir/workspace/link"
        readonly_paths_ok=1
        for inside in /etc /agentdir/../x /app/./reference /app/reference:rw /app/link; do
            if readonly_line=$(cd "$readonly_dir/workspace" && env -u GIT -u FRESH -u MASK \
                REPOS_PICK= SOCKETS= AGENTS= AGENTDIR="$readonly_dir/note" READONLY="$inside" \
                timeout 15 "$scriptdir/run" true 2>&1 </dev/null); then
                readonly_paths_ok=
                break
            fi
            if test "${readonly_line#*error: READONLY}" = "$readonly_line"; then
                readonly_paths_ok=
                break
            fi
        done
        if test -n "$readonly_paths_ok"; then
            ok_report "read-only paths" "outside paths, traversal, volume options and symlinks refused"
        else
            missing_report required "read-only paths" "$inside: $readonly_line"
        fi
        echo host-published > "$readonly_dir/pending"
        (
            for attempt in $(seq 120); do
                if test -f "$readonly_dir/note/markers/ready"; then
                    mv "$readonly_dir/pending" "$readonly_dir/note/messages/published"
                    exit 0
                fi
                sleep 1
            done
            exit 1
        ) &
        readonly_writer=$!
        if readonly_line=$(cd "$readonly_dir/workspace" && env -u GIT -u FRESH -u MASK \
            REPOS_PICK= SOCKETS= AGENTS= AGENTDIR="$readonly_dir/note" \
            READONLY='/agentdir/messages /app/reference /agentdir/messages/' \
            timeout 150 "$scriptdir/run" bash -seu 2>&1 <<'EOF'
for path in /agentdir/messages /app/reference; do
    if touch "$path/blocked" 2>/tmp/readonly-error; then
        exit 1
    fi
    grep -q 'Read-only file system' /tmp/readonly-error
done
touch /app/writable /agentdir/markers/ready
for attempt in $(seq 120); do
    if test -f /agentdir/messages/published; then
        test "$(cat /agentdir/messages/published)" = host-published
        echo readonly-ok
        exit 0
    fi
    sleep 1
done
exit 1
EOF
        ) && test "$(echo "$readonly_line" | tr -d '\r' | tail -1)" = readonly-ok; then
            ok_report "read-only folders" "writes refused, siblings writable, host rename visible"
        else
            missing_report required "read-only folders" "$readonly_line"
        fi
        kill "$readonly_writer" 2>/dev/null || true
        wait "$readonly_writer" 2>/dev/null || true
        rm -rf "$readonly_dir"

        # The boundary, tried from inside a box as an agent would: what the
        # docs promise to keep from it. A scratch repository with a secret at
        # the top, one in a subfolder and one in a folder named in MASK, and
        # a hook kept in the work tree.
        boundary_dir=$(mktemp -d)
        mkdir -p "$boundary_dir/repo/api" "$boundary_dir/repo/keys" "$boundary_dir/repo/.hooks" "$boundary_dir/plain"
        echo secret > "$boundary_dir/repo/.env"
        echo secret > "$boundary_dir/repo/api/.env"
        echo secret > "$boundary_dir/repo/keys/key.pem"
        echo template > "$boundary_dir/repo/.env.example"
        echo one > "$boundary_dir/repo/a.txt"
        printf '.env\nkeys\n' > "$boundary_dir/repo/.gitignore"
        if command -v git >/dev/null 2>&1 && command -v socat >/dev/null 2>&1; then
            git -C "$boundary_dir/repo" init -q -b main
            git -C "$boundary_dir/repo" -c user.name=self-check -c user.email=self-check@example.invalid \
                -c core.hooksPath=/dev/null add a.txt .env.example .gitignore
            git -C "$boundary_dir/repo" -c user.name=self-check -c user.email=self-check@example.invalid \
                -c core.hooksPath=/dev/null commit -q -m "self-check: first"
            git -C "$boundary_dir/repo" config user.name self-check
            git -C "$boundary_dir/repo" config user.email self-check@example.invalid
            git -C "$boundary_dir/repo" config core.hooksPath .hooks
            printf '#!/bin/sh\ntouch %q\n' "$boundary_dir/hook-ran" > "$boundary_dir/repo/.hooks/pre-commit"
            chmod +x "$boundary_dir/repo/.hooks/pre-commit"
            if boundary_line=$(cd "$boundary_dir/repo" && env -u FRESH -u READONLY -u AGENTDIR \
                REPOS_PICK= SOCKETS= AGENTS= GIT=commit MASK=keys \
                timeout 150 "$scriptdir/run" bash -seu 2>&1 <<'EOF'
# Each step says its name first: the last line printed is the one that failed.
echo "failed: .git is not read-only"
if touch /app/.git/blocked 2>/dev/null; then
    exit 1
fi
echo "failed: .env at the top is in sight"
test ! -s /app/.env
echo "failed: a nested .env is in sight"
test ! -s /app/api/.env
echo "failed: a folder named in MASK is in sight"
test -z "$(ls -A /app/keys)"
echo "failed: the template .env.example is hidden"
test "$(cat /app/.env.example)" = template
echo "failed: the relay did not commit a change"
echo two >> /app/a.txt
commit -m "self-check: a change from the box" a.txt >/dev/null
echo "failed: the relay took a submodule entry"
printf 'diff --git a/sub b/sub\nnew file mode 160000\nindex 0000000..1111111\n--- /dev/null\n+++ b/sub\n@@ -0,0 +1 @@\n+Subproject commit 1111111111111111111111111111111111111111\n' > /tmp/sub.diff
if commit -m "self-check: a submodule" /tmp/sub.diff >/dev/null 2>&1; then
    exit 1
fi
echo "failed: the relay took a patch on a masked file"
printf 'diff --git a/.env b/.env\nnew file mode 100644\n--- /dev/null\n+++ b/.env\n@@ -0,0 +1 @@\n+changed\n' > /tmp/env.diff
if commit -m "self-check: the masked file" /tmp/env.diff >/dev/null 2>&1; then
    exit 1
fi
echo boundary-ok
EOF
            ) && test "$(echo "$boundary_line" | tr -d '\r' | tail -1)" = boundary-ok \
                && test "$(git -C "$boundary_dir/repo" rev-list --count HEAD)" = 2 \
                && test -z "$(git -C "$boundary_dir/repo" ls-files sub .env)"; then
                if test -e "$boundary_dir/hook-ran"; then
                    missing_report required "boundary of a repository" "the relay ran a hook kept in the work tree"
                else
                    ok_report "boundary of a repository" ".git read-only, secrets hidden, relay: no hook, no submodule"
                fi
            else
                missing_report required "boundary of a repository" "$(echo "$boundary_line" | tr -d '\r' | tail -1)"
            fi
        else
            missing_report optional "boundary of a repository" "needs git and socat on the host"
        fi

        # A folder that is no repository does not become one, and nothing
        # of the stand-in for .git is left when the box has ended.
        if boundary_line=$(cd "$boundary_dir/plain" && env -u FRESH -u READONLY -u AGENTDIR -u GIT -u MASK \
            REPOS_PICK= SOCKETS= AGENTS= \
            timeout 150 "$scriptdir/run" bash -seu 2>&1 <<'EOF'
echo "failed: the box made .git in a folder that had none"
if mkdir -p /app/.git/hooks 2>/dev/null; then
    exit 1
fi
echo plain-ok
EOF
        ) && test "$(echo "$boundary_line" | tr -d '\r' | tail -1)" = plain-ok \
            && ! test -e "$boundary_dir/plain/.git"; then
            ok_report "no .git where none was" "the box cannot make one; nothing left"
        else
            missing_report required "no .git where none was" "$(echo "$boundary_line" | tr -d '\r' | tail -1 | sed 's/^plain-ok$/a .git folder was left behind/')"
        fi

        # The box ends with bin/run: SIGTERM to the one ends the other.
        sleep_seconds=$((80000 + $$ % 6000))
        ( cd "$boundary_dir/plain" && exec env -u FRESH -u READONLY -u AGENTDIR -u GIT -u MASK \
            REPOS_PICK= SOCKETS= AGENTS= "$scriptdir/run" sleep "$sleep_seconds" </dev/null >/dev/null 2>&1 ) &
        boundary_run=$!
        is_box_seen=
        for attempt in $(seq 60); do
            if podman ps --no-trunc --format '{{.Command}}' 2>/dev/null | grep -q "sleep $sleep_seconds"; then
                is_box_seen=1
                break
            fi
            sleep 0.5
        done
        kill -TERM "$boundary_run" 2>/dev/null || true
        wait "$boundary_run" 2>/dev/null || true
        is_box_gone=
        for attempt in $(seq 30); do
            if ! podman ps --no-trunc --format '{{.Command}}' 2>/dev/null | grep -q "sleep $sleep_seconds"; then
                is_box_gone=1
                break
            fi
            sleep 0.5
        done
        if test -n "$is_box_seen" && test -n "$is_box_gone"; then
            ok_report "the box ends with bin/run" "SIGTERM to bin/run stopped it"
        else
            missing_report required "the box ends with bin/run" "seen: ${is_box_seen:-no}, gone: ${is_box_gone:-no}"
        fi
        rm -rf "$boundary_dir"
    else
        missing_report optional "container inside box" "no image yet; bin/build"
    fi
fi

echo
if test "$missing_required" -gt 0; then
    EXIT_MESSAGE="${RED}bin/self-check failed: $missing_required required item(s) missing${RESET} -- run bin/configure"
    exit 1
fi
if test "$missing_optional" -gt 0; then
    EXIT_MESSAGE="${GREEN}bin/self-check succeeded: host is ready${RESET} ($missing_optional optional item(s) absent)"
else
    EXIT_MESSAGE="${GREEN}bin/self-check succeeded: host is ready${RESET}"
fi
