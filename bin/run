#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

usage_print () {
    echo "usage: $scriptname [command [arg...]]"
    echo "Opens the box on the current directory, at /app, and runs the command in it,"
    echo "bash when none: $scriptname claude, $scriptname make test. Set in the environment:"
    echo "  FRESH=1                programs only: no workspace, saved settings or login;"
    echo "                         FRESH=app keeps the current directory at /app"
    echo "  AGENTDIR=<dir>         that folder at /agentdir"
    echo "  AGENTS=<dir>           that folder at /agents, read only"
    echo "  REPOS=<dir>            that folder at /repos, not ~/repos; empty for none"
    echo "  REPOS_PICK='a b'       only those repositories of it at /repos"
    echo "  SOCKETS=<dir>          that folder at /sockets, not ~/sockets; empty for none"
    echo "  READONLY='/app/x ...'  those folders under /app or /agentdir read only"
    echo "  MASK='a.pem keys'      more files and folders of the workspace hidden, as .env is"
    echo "  GIT=commit             commit, tag, push and pull your branch through the host"
    echo "  PIDS, MEMORY, CPUS     the box's limits"
    echo "  CLAUDE_CODE_OAUTH_TOKEN, CODEX_API_KEY, OPENAI_API_KEY   the agent's own sign-in"
    echo "More in $(dirname "$scriptdir")/docs/README.md."
}

# Only the first argument: the rest is the command, and `bin/run claude
# --help` is the agent's help.
case "${1:-}" in
    -h|--help) usage_print; exit 0 ;;
esac

# The box is safe because podman runs it as you, with no more rights than
# you have. As root the same command line is a privileged container.
if test "$(id -u)" -eq 0; then
    echo "error: run it as yourself, not as root: the box is rootless" >&2
    exit 1
fi

# A fresh box keeps only the programs in data/extras. Mounting the workspace
# is a separate choice; the host's default repos and sockets never follow it.
fresh=${FRESH:-}
case "$fresh" in
    ""|1|app) ;;
    *)
        echo "error: FRESH=$fresh; use 1 (no workspace) or app (current folder)" >&2
        exit 1 ;;
esac
if test -n "$fresh"; then
    for name in GIT REPOS REPOS_PICK SOCKETS AGENTDIR AGENTS; do
        if test -n "${!name:-}"; then
            echo "error: FRESH cannot be combined with $name; unset it for a fresh box" >&2
            exit 1
        fi
    done
    if test "$fresh" = 1 && test -n "${MASK:-}"; then
        echo "error: MASK needs a workspace; use FRESH=app or unset MASK" >&2
        exit 1
    fi
    if test "$fresh" = 1 && test -n "${READONLY:-}"; then
        echo "error: READONLY needs a host mount; use FRESH=app or unset READONLY" >&2
        exit 1
    fi
    REPOS_PICK=
    SOCKETS=
fi

# The workspace is the directory you ran this from, handed to the box
# read-write as /app. From $HOME that would be every dotfile, key and
# repository at once -- and so would any directory that contains $HOME,
# or / itself. Compare resolved paths, so a symlink cannot slip past.
workspace=
home=
if test "$fresh" != 1; then
    workspace=$(realpath "$PWD")
    home=$(realpath "$HOME")

    if test "$workspace" = /; then
        echo "error: refusing to mount / as the workspace" >&2
        exit 1
    fi
    case "$workspace" in
        *:*)
            echo "error: the workspace has a colon in its path, which a mount cannot name: $workspace" >&2
            exit 1 ;;
    esac
    case "$home/" in
        "$workspace"/*)
            echo "error: $workspace contains your home directory ($home);" >&2
            echo "       running from here would hand every dotfile and key to the box." >&2
            exit 1 ;;
    esac
fi

# Your ssh-agent stays outside. podman passes no variable it is not given, so
# SSH_AUTH_SOCK never enters; but a mount that holds the socket hands it in,
# and the box signs with every key the agent holds. Read-only does not help.
ssh_agent_socket=
if test -n "$workspace" && test -S "${SSH_AUTH_SOCK:-}"; then
    ssh_agent_socket=$(realpath "$SSH_AUTH_SOCK")
fi
ssh_agent_refuse () {
    case "$ssh_agent_socket" in
        "$2"/*)
            echo "error: $1 ($2) holds your ssh-agent's socket ($ssh_agent_socket);" >&2
            echo "       mounted, it would let the box use every key the agent holds." >&2
            exit 1 ;;
    esac
}
if test -n "$workspace"; then
    ssh_agent_refuse "the workspace" "$workspace"
fi

# Fail fast when the image is not built. Without this podman treats `ai-box` as
# a short name and tries to pull it from a registry, which on a host with
# docker.io in registries.conf looks like a hang and leaves a half-made
# container behind when interrupted.
if ! podman image exists ai-box; then
    echo "error: no 'ai-box' image on this host -- build it first:" >&2
    echo "         $scriptdir/build" >&2
    echo "       (bin/self-check reports what else may be absent)" >&2
    exit 1
fi

# Everything the box keeps between runs lives in this repo, under data/:
# agent state, the shared image store, the build stamp. This is not an app you
# install once -- you pull the repo and rebuild it, often more than once a day
# -- so its state belongs beside the tree it was built from, where one `rm -rf`
# clears it and nothing is left anywhere else on the host. Anchored to the
# script, not to $PWD, so the box finds the same state from any workspace.
#
# Kept apart from the host user's own dotfiles either way: the box logs in,
# keeps its history and rewrites its config without touching whatever you run
# outside it. (Running bin/run from this repo therefore shows the box its own
# state at /app/data -- the same files, not a copy.)
data="$(dirname "$scriptdir")/data"

# Undotted on this side of the mount: nothing here is hidden from the person
# who owns it, and `ls data/` should show what the box is keeping. They land
# on their usual dotted names inside the box.
#
# Bind-mounting a path that does not exist makes a directory of it, and the
# agents want files. Create them as `{}` rather than let that happen: an
# empty one is not JSON, and claude reports it corrupted ("Unexpected EOF").
if test -z "$fresh"; then
    mkdir -p "$data/codex" "$data/claude"
    test -s "$data/codex.json" || echo '{}' > "$data/codex.json"
    test -s "$data/claude.json" || echo '{}' > "$data/claude.json"
fi

# The browsers, the whisper model, Chrome and both agent CLIs are not in the
# image: bin/build fills data/extras with them (notes/extras.md), the agents
# first. Without the agents there is nothing to start; without the rest the
# box starts, and says so once, since a broken browser must not keep you from
# your agents.
if ! test -x "$data/extras/npm/current/bin/claude"; then
    echo "error: no agent CLIs in $data/extras -- fill it with:" >&2
    echo "         $scriptdir/build" >&2
    echo "       (its whole output goes to $data/logs/)" >&2
    exit 1
fi
if ! test -f "$data/extras/versions"; then
    echo "warning: the last fill of $data/extras did not finish: browsers, Chrome" >&2
    echo "         or the whisper model may be missing; see $data/logs/" >&2
fi

opts=()

# Running from ai-box itself must not reveal its saved logins through
# /app/data. A temporary mount with copy-up disabled hides that subtree, even
# when the workspace is an ancestor of the checkout. A workspace inside data/
# cannot be made fresh, so refuse it rather than expose part of the state.
if test -n "$workspace"; then
    opts+=(-v "$workspace:/app")
    if test "$fresh" = app; then
        data_resolved=$(realpath -m "$data")
        case "$workspace/" in
            "$data_resolved"/*)
                echo "error: FRESH=app cannot mount a workspace inside $data" >&2
                exit 1 ;;
        esac
        case "$data_resolved/" in
            "$workspace"/*)
                opts+=(--tmpfs "/app/${data_resolved#"$workspace"/}:rw,exec,nosuid,nodev,mode=1777,notmpcopyup") ;;
        esac
    fi
else
    # WORKDIR /app in the image is root-owned. Give ubuntu a writable empty
    # workspace without binding any folder from the host.
    opts+=(--tmpfs "/app:rw,exec,nosuid,nodev,mode=1777,notmpcopyup")
fi

# Short-lived files of this run: the container's id, and with GIT=commit the
# relay scripts and their sockets. Gone when bin/run ends.
rundir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/ai-box.XXXXXX")
relays=()
git_placeholder=
exit_cleanup () {
    if test "${#relays[@]}" -gt 0; then
        kill "${relays[@]}" 2>/dev/null || true
    fi
    # Only ever an empty folder: rmdir leaves anything else alone. Not while
    # another box stands on the same workspace: removing the folder would
    # take the mount from under it, and its /app/.git would be writable.
    if test -n "$git_placeholder"; then
        boxes_count=$(
            for id in $(podman ps --quiet 2>/dev/null); do
                podman inspect --format '{{range .Mounts}}{{if eq .Destination "/app"}}{{.Source}}{{end}}{{end}}' "$id" 2>/dev/null || true
            done | grep -cxF "$workspace" || true
        )
        if test "$boxes_count" = 0; then
            rmdir "$git_placeholder" 2>/dev/null || true
        fi
    fi
    rm -rf "$rundir"
}
trap exit_cleanup EXIT

# Read-only, mounted over the read-write workspace, always: a box with write
# access to .git can rewrite history, move or delete any branch, drop stashes.
# GIT=commit gives the agent commit, tag, push and pull through the host instead;
# see the relays below.
case "${GIT:-}" in
    "") is_git_relayed= ;;
    commit) is_git_relayed=1 ;;
    rw)
        echo "error: GIT=rw is gone: .git stays read-only, and GIT=commit" >&2
        echo "       commits, pushes and pulls through the host" >&2
        exit 1 ;;
    *)
        echo "error: GIT=$GIT; the only value is commit" >&2
        exit 1 ;;
esac
for name in AI_BOX_MASK AI_BOX_PIDS AI_BOX_MEMORY AI_BOX_CPUS; do
    if test -n "${!name+set}"; then
        echo "error: $name is gone: use ${name#AI_BOX_}" >&2
        exit 1
    fi
done

# A workspace that is no repository does not become one in the box: an empty
# read-only folder stands at /app/.git, and git init is yours, on the host. A
# .git the box had made, config and all, would be read by your next git in
# that folder, a shell prompt's included, and run what it names. Podman makes
# the folder for the mount; it stays empty and goes when the box ends, so
# nothing is left where nothing was. One left by a box that was killed is
# empty too, and is taken for none.
if test -n "$workspace"; then
    if test -L "$workspace/.git"; then
        opts+=(-v "$workspace/.git:/app/.git:ro")
    elif ! test -e "$workspace/.git" || { test -d "$workspace/.git" && test -z "$(ls -A "$workspace/.git" 2>/dev/null)"; }; then
        opts+=(--tmpfs "/app/.git:ro,nosuid,nodev,noexec,mode=0555,notmpcopyup")
        git_placeholder=$workspace/.git
    else
        opts+=(-v "$workspace/.git:/app/.git:ro")
    fi
fi

# Secrets never enter the box: every .env and .env.* in the workspace, at any
# depth, is replaced with /dev/null -- the same set .gitignore keeps out of
# git. The committed templates (.env.example and friends) hold no secrets and
# stay visible, or git inside the box would report them as emptied. The search
# does not enter node_modules, vendor or .git: other people's code and git's
# own files, and the bulk of a tree; it costs a few hundredths of a second on
# 25,000 files. The list is taken at the start: a .env made later is in sight.
# MASK adds more names, space-separated, relative to the workspace, files and
# folders, patterns too:
#   MASK="credentials.json service-account.pem keys" bin/run
# A name it cannot hide is said, never skipped in silence: the box would start
# with the file in plain sight. Not an error: one MASK may serve many projects.

# env_files_print <folder>...: the .env and .env.* files under them, each
# ended by a NUL, the templates left out.
env_files_print () {
    find "$@" -xdev \( -name node_modules -o -name vendor -o -name .git \) -prune \
        -o \( -name .env -o -name '.env.*' \) \
        ! -name '*.example' ! -name '*.sample' ! -name '*.template' ! -name '*.dist' \
        \( -type f -o -type l \) -print0 2>/dev/null || true
}

# mask_mount <path in the box> <path on the host>: a file reads as /dev/null,
# a folder as an empty read-only one. A path is mounted once, however many
# times it is named; one with a colon cannot be written as a mount, and is
# said.
declare -A mask_seen=()
mask_mount () {
    if test -n "${mask_seen[$1]+set}"; then
        return
    fi
    mask_seen[$1]=1
    case "$1" in
        *:*)
            echo "ai-box: cannot hide $1: a colon in its path" >&2
            return ;;
    esac
    if test -d "$2"; then
        opts+=(--tmpfs "$1:ro,nosuid,nodev,noexec,mode=0555,notmpcopyup")
    else
        opts+=(-v "/dev/null:$1:ro")
    fi
}

masked_paths=()
if test -n "$workspace"; then
    while IFS= read -r -d '' env_file; do
        env_file="${env_file#"$workspace"/}"
        test -f "$workspace/$env_file" || continue
        mask_mount "/app/$env_file" "$workspace/$env_file"
        masked_paths+=("$env_file")
    done < <(env_files_print "$workspace")
    shopt -s nullglob dotglob
    mask_words=()
    read -r -d '' -a mask_words <<<"${MASK:-}" || true
    for mask_word in "${mask_words[@]}"; do
        # Unquoted on purpose: a pattern becomes the names it matches, and
        # nothing when it matches none.
        mask_matches=($mask_word)
        if test "${#mask_matches[@]}" = 0; then
            echo "ai-box: MASK: nothing matches $mask_word in the workspace, skipped" >&2
        fi
        for mask_match in "${mask_matches[@]}"; do
            mask_path=$(realpath -m -s --relative-to="$workspace" -- "$mask_match")
            case "$mask_path" in
                .|..|../*)
                    echo "ai-box: MASK: $mask_match is not inside the workspace, skipped" >&2
                    continue ;;
                .git|.git/*)
                    echo "ai-box: MASK: $mask_path is the repository itself, skipped" >&2
                    continue ;;
            esac
            if ! test -f "$workspace/$mask_path" && ! test -d "$workspace/$mask_path"; then
                echo "ai-box: MASK: no $mask_path in the workspace, skipped" >&2
                continue
            fi
            is_masked=
            for masked_path in "${masked_paths[@]}"; do
                if test "$masked_path" = "$mask_path"; then
                    is_masked=1
                fi
            done
            if test -z "$is_masked"; then
                mask_mount "/app/$mask_path" "$workspace/$mask_path"
                masked_paths+=("$mask_path")
            fi
        done
    done
    shopt -u nullglob dotglob
fi

# GIT=commit: the box holds no key and cannot write .git, so the host does the
# git work. `commit`, `tag`, `push` and `pull` inside the box each connect to a
# socket the host listens on, and the host runs a fixed script in the
# workspace, for the branch checked out when the box started:
#   commit   a patch and a message from the box, applied on HEAD and
#            committed: as you; your staging left alone
#   tag      a name from the box, and a message for an annotated one: a new
#            tag on HEAD
#   push     git push --no-follow-tags origin <branch>:<branch>, and the tags
#            made by `tag` for this box
#   pull     git fetch of <branch>, then git merge; a conflict is undone
# No force, no other branch, no tag moved or deleted, no rewriting. No hook
# either, in any of the four: a hook is a file of the work tree or runs one,
# the box writes the work tree, and the host would run the box's code as you.
# The relays end with the box.
if test -n "$is_git_relayed"; then
    if test -n "$git_placeholder"; then
        echo "error: GIT=commit, but $workspace is not a git repository;" >&2
        echo "       run git init there first: the box cannot make one" >&2
        exit 1
    fi
    if ! command -v git >/dev/null 2>&1; then
        echo "error: GIT=commit needs git on the host (bin/configure)" >&2
        exit 1
    fi
    branch=$(git -C "$workspace" symbolic-ref --quiet --short HEAD || true)
    if ! test -d "$workspace/.git"; then
        echo "error: GIT=commit, but $workspace/.git is not a directory" >&2
        echo "       (a linked worktree or a submodule checkout points outside" >&2
        echo "       the workspace, where the box cannot follow)" >&2
        exit 1
    elif test -z "$branch"; then
        echo "error: GIT=commit, but HEAD is detached; check out a branch first" >&2
        exit 1
    elif ! command -v socat >/dev/null 2>&1; then
        echo "error: GIT=commit needs socat on the host (bin/configure)" >&2
        exit 1
    fi
    # The scripts stay outside the box; only box/ goes in, read-only, for the
    # sockets and the branch name.
    relaydir=$rundir/git
    mkdir -p "$relaydir/box"
    echo "$branch" > "$relaydir/box/branch"
    # relay_start <name> < body: serves the script on box/<name>.sock. Each
    # connection runs it once: the box's bytes on its stdin, its output back.
    relay_start () {
        local name=$1
        {
            echo '#!/bin/bash'
            printf 'workspace=%q\n' "$workspace"
            printf 'branch=%q\n' "$branch"
            printf 'tags_file=%q\n' "$relaydir/tags"
            printf 'masked_paths=('
            printf ' %q' "${masked_paths[@]}"
            printf ' )\n'
            cat <<'EOF'
# No errexit: each script ends with a line that carries its status to the
# box, so a failure is checked where it can happen, not left to end the script.
set -o nounset -o pipefail
# The box may hang up before the answer: the script goes on to its cleanup.
trap '' PIPE
export GIT_TERMINAL_PROMPT=0 GIT_LITERAL_PATHSPECS=1
unset GIT_INDEX_FILE
# No hook runs for the box: core.hooksPath set to a place that holds none,
# for every git below and whatever git starts itself. And git's own tidying
# stays in the foreground, so it ends before the next relay takes its turn.
# Both go after any configuration your environment already passes; the last
# one wins.
config_count=${GIT_CONFIG_COUNT:-0}
export "GIT_CONFIG_KEY_$config_count=core.hooksPath"
export "GIT_CONFIG_VALUE_$config_count=/dev/null"
export "GIT_CONFIG_KEY_$((config_count + 1))=gc.autoDetach"
export "GIT_CONFIG_VALUE_$((config_count + 1))=false"
export GIT_CONFIG_COUNT=$((config_count + 2))
cd "$workspace" || exit 1
# One relay at a time on a repository, whichever box asks: each reads HEAD
# and then writes it. The lock is on the .git folder itself, so nothing is
# added to it.
exec 9< .git || exit 1
flock 9 || exit 1
check_branch () {
    local current
    current=$(git symbolic-ref --quiet --short HEAD)
    if test "$current" != "$branch"; then
        echo "the box was started on $branch, and the host is on ${current:-a detached HEAD} now"
        return 1
    fi
}
EOF
            cat
        } > "$relaydir/$name"
        chmod 700 "$relaydir/$name"
        # setsid: no terminal to prompt on, so a locked key fails the push
        # instead of asking for a passphrase over the box's own screen.
        # -t: the box closes its side once it has sent; the answer may take
        # as long as git or the network does.
        setsid socat -t 3600 "UNIX-LISTEN:$relaydir/box/$name.sock,fork,max-children=8,mode=600" "EXEC:$relaydir/$name" \
            </dev/null >/dev/null 2>&1 &
        relays+=($!)
        for _ in $(seq 20); do
            test -S "$relaydir/box/$name.sock" && break
            sleep 0.05
        done
    }
    relay_start commit <<'EOF'
# A message ended by a NUL, then the patch. The patch goes on HEAD in a scratch
# index, so neither your staging nor the working tree is read or changed; then
# git commit, with no hook run, and your index follows for the paths it touched.
# A masked file is refused: the box sees it emptied. So is a submodule entry,
# and .gitmodules: the folder of a submodule is a repository the box writes,
# config included, and once your index names it, your next git status reads
# that config and runs what it says.
# A request is 100 MiB at most, message and patch together: more is refused,
# not spooled. The spool is removed however the script ends.
request_max=104857600
tempdir=
trap 'test -z "$tempdir" || rm -rf "$tempdir"' EXIT
commit () {
    local message= path masked_path status paths=()
    tempdir=$(mktemp -d) || return 1
    head -c "$((request_max + 1))" > "$tempdir/request" || return 1
    if test "$(stat -c %s "$tempdir/request")" -gt "$request_max"; then
        echo "commit: the patch is larger than $((request_max / 1048576)) MiB"
        return 1
    fi
    {
        IFS= read -r -d '' message || true
        cat > "$tempdir/patch"
    } < "$tempdir/request" || return 1
    if test -z "$message" || ! test -s "$tempdir/patch"; then
        echo "commit: needs a message and a patch"
        rm -rf "$tempdir"
        return 1
    fi
    check_branch || { rm -rf "$tempdir"; return 1; }
    export GIT_INDEX_FILE="$tempdir/index"
    git read-tree HEAD || return 1
    if ! git apply --cached "$tempdir/patch"; then
        echo "commit: the patch does not apply to $branch as it is now"
        rm -rf "$tempdir"
        return 1
    fi
    while IFS= read -r -d '' path; do
        for masked_path in "${masked_paths[@]}"; do
            if test "$path" = "$masked_path" || test "${path#"$masked_path"/}" != "$path"; then
                echo "commit: $path is hidden from the box; commit it yourself"
                rm -rf "$tempdir"
                return 1
            fi
        done
        if test "$path" = .gitmodules; then
            echo "commit: .gitmodules is the list of submodules; commit it yourself"
            rm -rf "$tempdir"
            return 1
        elif test "$(git ls-files -s -- "$path" | cut -c1-6)" = 160000; then
            echo "commit: $path is a submodule entry; commit it yourself"
            rm -rf "$tempdir"
            return 1
        fi
        paths+=("$path")
    done < <(git diff --cached --name-only --no-renames -z HEAD)
    if test "${#paths[@]}" -eq 0; then
        echo "commit: the patch changes nothing"
        rm -rf "$tempdir"
        return 1
    fi
    git commit --no-edit -F - <<<"$message"
    status=$?
    unset GIT_INDEX_FILE
    if test "$status" = 0; then
        git reset -q -- "${paths[@]}"
    fi
    rm -rf "$tempdir"
    return "$status"
}
commit 2>&1
echo "commit: exit $?"
EOF
    relay_start tag <<'EOF'
# A name ended by a NUL, then the message of an annotated tag, or nothing. The
# tag goes on the commit the branch is at. A name that is there already on
# that commit counts as made; on another commit it is refused: no tag is
# moved or deleted. The name is kept for push, which sends these tags only.
tag () {
    local name= message head_commit tag_commit
    IFS= read -r -d '' name || true
    message=$(cat)
    case "$name" in
        ""|-*|HEAD|refs/*)
            echo "tag: not a tag name: $name"
            return 1 ;;
    esac
    if ! git check-ref-format "refs/tags/$name"; then
        echo "tag: not a tag name: $name"
        return 1
    fi
    # A tag named as a branch makes that name mean two things to your git.
    if git show-ref --verify --quiet "refs/heads/$name" || git show-ref --verify --quiet "refs/remotes/$name"; then
        echo "tag: $name is the name of a branch"
        return 1
    fi
    check_branch || return 1
    head_commit=$(git rev-parse --verify HEAD) || return 1
    tag_commit=$(git rev-parse --quiet --verify "refs/tags/$name^{commit}" || true)
    if test -n "$tag_commit" && test "$tag_commit" != "$head_commit"; then
        echo "tag: $name is there already, on ${tag_commit:0:7}; a tag is never moved"
        return 1
    elif test -n "$tag_commit"; then
        echo "tag: $name is there already, on this commit; push sends it to origin"
    else
        if test -n "$message"; then
            git tag -a -F - "$name" "$head_commit" <<<"$message" || return
        else
            git tag "$name" "$head_commit" || return
        fi
        echo "tag: $name is on ${head_commit:0:7}; push sends it to origin"
    fi
    echo "$name" >> "$tags_file"
}
tag 2>&1
echo "tag: exit $?"
EOF
    relay_start push <<'EOF'
# The branch, and with it the tags `tag` made for this box, those that are
# still there. A tag of your own is not sent: it is yours to push.
push () {
    local name refs=("refs/heads/$branch:refs/heads/$branch")
    if test -s "$tags_file"; then
        while IFS= read -r name; do
            if git rev-parse --quiet --verify "refs/tags/$name" >/dev/null; then
                refs+=("refs/tags/$name")
            fi
        done < <(sort -u "$tags_file")
    fi
    git push --no-follow-tags origin "${refs[@]}"
}
push </dev/null 2>&1
echo "push: exit $?"
EOF
    relay_start pull <<'EOF'
pull () {
    check_branch || return 1
    git fetch --no-tags --no-recurse-submodules origin "+refs/heads/$branch:refs/remotes/origin/$branch" || return
    if git merge --no-edit "refs/remotes/origin/$branch"; then
        return 0
    fi
    # git merge refuses before it starts (local changes in the way) or stops
    # halfway with conflicts; only the second leaves MERGE_HEAD.
    git rev-parse --quiet --verify MERGE_HEAD >/dev/null || return 1
    local conflicts
    # Not into submodules: their folders are the box's to write, config and all.
    conflicts=$(git diff --ignore-submodules=all --name-only --diff-filter=U)
    git merge --abort
    echo
    echo "pull: origin/$branch conflicts with $branch in:"
    sed 's/^/  /' <<<"$conflicts"
    echo "pull: the merge is undone, the tree is as it was. Stop here and ask the author how to resolve it."
    return 2
}
pull </dev/null 2>&1
echo "pull: exit $?"
EOF
    opts+=(-v "$relaydir/box:/run/git:ro")
    echo "ai-box: commit, tag, push and pull work on $branch, through the host; .git is read-only" >&2
fi

# Mounted when present, so this script still runs on a machine that has not
# set them up. An absent path would otherwise be created as an empty
# directory. REPOS names another folder for /repos; set but empty, no /repos.
#   REPOS=~/w bin/run claude
# Set but wrong is an error, as with AGENTDIR. Read-only, but never /, $HOME or
# anything containing it: the box would read every key there.
# REPOS_PICK picks repositories of that folder, each at /repos/<name>, for an
# agent that reads only those; a name with no folder there is skipped. Set but
# empty, no /repos, and REPOS is not looked at.
#   REPOS_PICK='rules infra' bin/run claude
repos=
repos_pick=()
if test -n "${REPOS_PICK+set}"; then
    read -r -d '' -a repos_pick <<<"$REPOS_PICK" || true
fi
if test -n "${REPOS_PICK+set}" && test "${#repos_pick[@]}" = 0; then
    : # a light agent, with no repositories
elif test -z "${REPOS+set}"; then
    if test -e "$HOME/repos"; then
        repos=$(realpath "$HOME/repos")
        ssh_agent_refuse "the default ~/repos" "$repos"
    fi
elif test -n "$REPOS"; then
    if ! test -d "$REPOS"; then
        echo "error: REPOS is not a directory: $REPOS" >&2
        exit 1
    fi
    repos=$(realpath "$REPOS")
    case "$home/" in
        "$repos"/*)
            echo "error: REPOS ($repos) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$repos" = /; then
        echo "error: refusing to mount / as REPOS" >&2
        exit 1
    fi
    ssh_agent_refuse REPOS "$repos"
fi

# The repositories /repos holds, as folders of the host: every one, or the
# picked ones. Symlinked folders are skipped: their targets are not mounted.
repo_dirs=()
if test -z "${REPOS_PICK+set}"; then
    if test -n "$repos"; then
        opts+=(-v "$repos:/repos:ro")
        shopt -s nullglob dotglob
        for repo_dir in "$repos"/*/; do
            repo_dir=${repo_dir%/}
            test -L "$repo_dir" || repo_dirs+=("$repo_dir")
        done
        shopt -u nullglob dotglob
    fi
else
    for name in "${repos_pick[@]}"; do
        case "$name" in
            .|..|*/*|*:*)
                echo "ai-box: REPOS_PICK: $name is not a repository name, skipped" >&2
                continue ;;
        esac
        picked_dir=$repos/$name
        if test -z "$repos" || ! test -d "$picked_dir"; then
            echo "ai-box: REPOS_PICK: no $name in ${repos:-REPOS}, skipped" >&2
            continue
        fi
        if test -L "$picked_dir"; then
            echo "ai-box: REPOS_PICK: $name is a symlink, skipped" >&2
            continue
        fi
        is_picked=
        for repo_dir in "${repo_dirs[@]}"; do
            if test "$repo_dir" = "$picked_dir"; then
                is_picked=1
            fi
        done
        if test -z "$is_picked"; then
            repo_dirs+=("$picked_dir")
            opts+=(-v "$picked_dir:/repos/$name:ro")
        fi
    done
fi

# Read-only is not hidden: every repository in /repos keeps its .env and
# .env.* out as the workspace does, at any depth, and a workspace inside
# /repos (a machine that starts the box in a folder of REPOS) is masked there
# as at /app, MASK included.
workspace_in_repos=
if test -n "$repos"; then
    case "$workspace/" in
        "$repos"/*) workspace_in_repos=${workspace#"$repos"/} ;;
    esac
fi
if test "${#repo_dirs[@]}" -gt 0; then
    while IFS= read -r -d '' env_file; do
        test -f "$env_file" || continue
        mask_mount "/repos/${env_file#"$repos"/}" "$env_file"
    done < <(env_files_print "${repo_dirs[@]}")
fi
if test -n "$workspace_in_repos"; then
    for repo_dir in "${repo_dirs[@]}"; do
        if test "$repo_dir" = "$repos/${workspace_in_repos%%/*}"; then
            for masked_path in "${masked_paths[@]}"; do
                mask_mount "/repos/$workspace_in_repos/$masked_path" "$workspace/$masked_path"
            done
        fi
    done
fi

# The host's sockets, a folder of them read-only at /sockets, so the box talks
# to a service of the host without the socket sitting in /repos. Read-only
# still connects: connect() writes nothing to the socket's filesystem. The
# folder is mounted, not each socket, so a service that starts again with a new
# socket is still reached. SOCKETS names another folder for /sockets; set but
# empty, no /sockets.
#   SOCKETS=~/w/sockets bin/run claude
# Set but wrong is an error, as with REPOS; never /, $HOME or anything
# containing it, nor the folder of your ssh-agent's socket.
sockets=
if test -z "${SOCKETS+set}"; then
    if test -e "$HOME/sockets"; then
        sockets=$(realpath "$HOME/sockets")
        ssh_agent_refuse "the default ~/sockets" "$sockets"
    fi
elif test -n "$SOCKETS"; then
    if ! test -d "$SOCKETS"; then
        echo "error: SOCKETS is not a directory: $SOCKETS" >&2
        exit 1
    fi
    sockets=$(realpath "$SOCKETS")
    case "$home/" in
        "$sockets"/*)
            echo "error: SOCKETS ($sockets) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$sockets" = /; then
        echo "error: refusing to mount / as SOCKETS" >&2
        exit 1
    fi
    ssh_agent_refuse SOCKETS "$sockets"
fi
if test -n "$sockets"; then
    opts+=(-v "$sockets:/sockets:ro")
fi

# The agent's folder of Visual Agency, read-write, so the agent answers in
# it: AGENTDIR names it and the box sees it as /agentdir.
#   AGENTDIR=~/agents/<id> bin/run claude
# Set but wrong is an error, not a box without the note. The same guard as the
# workspace: it is writable, so never /, $HOME or anything containing it.
agentdir=${AGENTDIR:-}
if test -n "$agentdir"; then
    if ! test -d "$agentdir"; then
        echo "error: AGENTDIR is not a directory: $agentdir" >&2
        exit 1
    fi
    agentdir=$(realpath "$agentdir")
    case "$home/" in
        "$agentdir"/*)
            echo "error: AGENTDIR ($agentdir) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$agentdir" = /; then
        echo "error: refusing to mount / as AGENTDIR" >&2
        exit 1
    fi
    ssh_agent_refuse AGENTDIR "$agentdir"
    opts+=(-v "$agentdir:/agentdir")
fi

# Every agent's folder, the app's folder of agents read-only at /agents, so one
# agent reads the others' conversations, plans and documents and changes none
# of them. Its own is one folder of it: still read-write at /agentdir, and
# read-only at /agents/<id>. Unset or empty, no /agents.
#   AGENTS=~/agents bin/run claude
# Set but wrong is an error, as with SOCKETS; never /, $HOME or anything
# containing it, nor the folder of your ssh-agent's socket.
agents=${AGENTS:-}
if test -n "$agents"; then
    if ! test -d "$agents"; then
        echo "error: AGENTS is not a directory: $agents" >&2
        exit 1
    fi
    agents=$(realpath "$agents")
    case "$home/" in
        "$agents"/*)
            echo "error: AGENTS ($agents) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$agents" = /; then
        echo "error: refusing to mount / as AGENTS" >&2
        exit 1
    fi
    ssh_agent_refuse AGENTS "$agents"
    opts+=(-v "$agents:/agents:ro")
fi

# The agent's own sign-in, when the shell that starts the box sets one:
# passed by name, so its value is on no command line and never in data/.
#   CLAUDE_CODE_OAUTH_TOKEN  claude prefers it to the shared sign-in
#   CODEX_API_KEY            codex prefers it to the shared sign-in
#   OPENAI_API_KEY           for other tools; codex 0.163 ignores it
for name in CLAUDE_CODE_OAUTH_TOKEN CODEX_API_KEY OPENAI_API_KEY; do
    if test -n "${!name:-}"; then
        opts+=(--env "$name")
    fi
done

# Fresh boxes accept explicit credentials without mounting saved sign-ins.
if test -z "$fresh"; then
    opts+=(-v "$data/codex.json:/home/ubuntu/.codex.json")
    opts+=(-v "$data/claude.json:/home/ubuntu/.claude.json")
    opts+=(-v "$data/codex:/home/ubuntu/.codex")
    opts+=(-v "$data/claude:/home/ubuntu/.claude")
fi

# :O, an overlay: the host's folder is the lower layer and no box writes it,
# while a box may still write there -- a project's own `npx playwright
# install` -- into a layer that ends with the box, as writes into the image
# do. bin/build only adds folders and moves the `current` links while boxes
# run; it removes a version three days after it stopped being current.
opts+=(-v "$data/extras:/opt/extras:O")

# An image store shared in from the host: `docker run <image>` inside the box
# then needs no pull and no network. Fill it with
#   bin/images mysql:8.0
# from the host: a pull from inside lands in the box's own store and goes with
# it.
#
# Deliberately not :ro. Building FROM an image that lives only in this store
# makes the inner engine create and remove a transient mountpoint inside it
# ($store/overlay/$layer/merged), and read-only turns every such `docker build`
# into "removing mount point ...: read-only file system". Only those transient
# mountpoints are written; the images themselves are left alone.
if test -z "$fresh" && test -d "$data/images"; then
    opts+=(-v "$data/images:/var/lib/shared")
fi

# Selected folders are rebound read-only after the ordinary mounts. Split
# without glob expansion: a name containing * is a literal folder name.
# Symlinks are refused so a path under /app cannot import an outside folder.
# Missing folders (or an absent AGENTDIR) do not create mounts.
readonly_paths=()
read -r -d '' -a readonly_paths <<<"${READONLY:-}" || true
declare -A readonly_seen=()
for readonly_path in "${readonly_paths[@]}"; do
    inside=${readonly_path%/}
    case "$inside/" in
        */./*|*/../*|*//*|*:*)
            echo "error: READONLY takes plain paths, no ., .., empty components or colons: $inside" >&2
            exit 1 ;;
    esac
    case "$inside" in
        /agentdir/?*) outside=${agentdir:+$agentdir/${inside#/agentdir/}} ;;
        /app/?*) outside=${workspace:+$workspace/${inside#/app/}} ;;
        *)
            echo "error: READONLY names folders under /agentdir or /app: $inside" >&2
            exit 1 ;;
    esac
    if test -z "$outside" || ! test -d "$outside"; then
        continue
    fi
    if test "$(realpath -e "$outside")" != "$outside"; then
        echo "error: READONLY cannot follow symlinks: $inside" >&2
        exit 1
    fi
    if test "$fresh" = app; then
        case "$outside/" in
            "$data_resolved"/*)
                echo "error: READONLY cannot expose saved state hidden by FRESH=app: $inside" >&2
                exit 1 ;;
        esac
    fi
    if test -z "${readonly_seen[$inside]+set}"; then
        # .git already has this exact mount; Podman refuses duplicate targets.
        if test "$inside" != /app/.git; then
            opts+=(-v "$outside:$inside:ro")
        fi
        readonly_seen[$inside]=1
    fi
done

# Limits on the box as a whole -- the inner engine has cgroups disabled, so
# nothing inside can limit itself, and without these a runaway inner build
# takes the host down with it. Each applies only when the matching cgroup
# controller is delegated to your session (systemd does that by default on
# current Ubuntu; bin/self-check reports it). Override with an environment
# variable; 0 means no limit.
#
#   PIDS    default 4096
#   MEMORY  default three quarters of the host's RAM
#   CPUS    default unlimited
controllers=$(cat "/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers" 2>/dev/null || true)
is_delegated () { case " $controllers " in *" $1 "*) return 0 ;; esac; return 1; }

pids=${PIDS:-4096}
memory=${MEMORY:-$(awk '/^MemTotal:/ { printf "%dm", $2 * 3 / 4 / 1024 }' /proc/meminfo)}
cpus=${CPUS:-0}

if test "$pids" != 0 && is_delegated pids; then
    opts+=(--pids-limit "$pids")
fi
if test "$memory" != 0 && is_delegated memory; then
    opts+=(--memory "$memory")
fi
if test "$cpus" != 0 && is_delegated cpu; then
    opts+=(--cpus "$cpus")
fi

# A real init as PID 1: it reaps the orphans that daemonized services and
# agent subprocesses leave behind, and forwards SIGTERM so `podman stop` ends
# the box at once instead of after its full grace period. Podman looks for
# catatonit in its own helper directory; a distribution that installs it
# elsewhere gets the path spelled out. No catatonit, no --init: the box still
# runs, with bash reaping nothing.
if test -x /usr/libexec/podman/catatonit; then
    opts+=(--init)
elif command -v catatonit >/dev/null 2>&1; then
    opts+=(--init --init-path "$(command -v catatonit)")
fi

# A terminal only when there is one: bin/self-check --deep and CI call this
# with stdin redirected, and asking for a tty there is a warning at best.
tty=()
if test -t 0; then
    tty=(-t)
fi

# What each of the flags below is for:
#
#   --userns=keep-id:uid=1000,gid=1000 + --user 0
#       ubuntu inside is you outside, so /app and the agent state mounts are
#       writable and anything written lands owned by you, not by root. The
#       entrypoint still starts as root and setpriv's down.
#   --log-driver=none
#       The terminal reaches you through the tty, never through podman logs,
#       and a log driver would keep a copy of every frame of it on the host:
#       journald passes it to the host's syslog, and on to wherever the
#       host ships its logs, every secret the agent prints included. So
#       nothing of the box is logged outside it, and `podman logs` on a box
#       has nothing to show.
#   --shm-size=2g
#       Chrome and Playwright need more than the default 64m.
#   --device /dev/fuse
#       The inner overlay driver. Native overlayfs cannot stack on the box's
#       own overlay upperdir, so the inner engine uses fuse-overlayfs.
#   --device /dev/net/tun
#       Uplink for the inner network namespace.
#   --security-opt label=disable
#       For a host with SELinux: without it the mounts above would each need
#       relabelling, and the inner engine is refused its own mounts. Where
#       SELinux is off, as on Ubuntu, it changes nothing; AppArmor is not
#       touched by it.
#   --security-opt unmask=ALL
#       Two reasons. The inner runtime writes /proc/sys/net/ipv4/ping_group_range,
#       which is read-only by default; and it mounts a fresh /proc for every
#       inner container, which the kernel refuses while any part of the box's
#       own /proc is masked. So ALL, not a narrower list -- a partial unmask
#       fixes the first and not the second. In rootless mode the kernel still
#       enforces the real uid on every one of those paths.
#   --security-opt seccomp=unconfined
#       The inner runtime calls sethostname(2) in its own UTS namespace.
#   --sysctl net.ipv4.ping_group_range=1000 1000
#       ping without a raw socket. Podman's default for this is "0 0" -- only
#       gid 0 may open an unprivileged ICMP socket -- and the box runs as
#       ubuntu, so ping would fail on the socket instead. Both ends have to be
#       a gid that maps inside the user namespace, which is what keep-id below
#       guarantees for 1000; a wide range like 0-2147483647 is refused by the
#       runtime. Narrower than --cap-add=NET_RAW, which would hand every
#       process in the box raw packet access for the sake of one command.
#
# No --privileged and no docker socket: the box is rootless and unprivileged.
# What it reaches of the host is what is mounted above, the network (the
# host's own services beyond 127.0.0.1 among it), and with GIT=commit the
# relays, each running one fixed script there with no hook.

box=(podman run --rm -i "${tty[@]}" \
    --cidfile "$rundir/cid" \
    --pull=never \
    --log-driver=none \
    --shm-size=2g \
    "${opts[@]}" \
    "--userns=keep-id:uid=1000,gid=1000" \
    --user 0 \
    --device /dev/fuse \
    --device /dev/net/tun \
    --security-opt label=disable \
    --security-opt unmask=ALL \
    --security-opt seccomp=unconfined \
    --sysctl net.ipv4.ping_group_range="1000 1000" \
    ai-box "$@")

# Every start adds one line to data/logs/run.log: the time and the podman
# command as it runs, each argument quoted, so a box can be told apart from
# the next after its terminal is gone. A log that cannot be written is a
# warning: it must not keep you from your agents.
run_log=$data/logs/run.log
run_line="[$(date '+%F %T %Z')]$(printf ' %q' "${box[@]}")"
if ! { mkdir -p "$data/logs" && echo "$run_line" >> "$run_log"; } 2>/dev/null; then
    echo "warning: could not write $run_log" >&2
fi

# The box ends with bin/run. `podman run` is only a client: the container
# runs under conmon, and when podman run is killed the container runs on.
# That is how an agent outlived the shell Visual Agency had ended (SIGHUP to
# the shell, SIGTERM to the rest, SIGKILL 3 s later) and went on writing to
# its note beside the next agent. So podman runs in the background here, and
# SIGHUP, SIGTERM or SIGINT to bin/run stops the container: SIGTERM to its
# init, SIGKILL 3 s later. The stop is detached, in a session of its own, so
# it finishes when bin/run is killed in the middle of it. Before the id file
# is written there is no container yet, and the signal goes to podman run.
# Ctrl-C with a terminal never gets here: the tty is raw and the box sees
# the keystroke. Only a bare SIGKILL to bin/run leaves the box running.
box_stop () {
    trap '' HUP INT TERM
    if test -s "$rundir/cid"; then
        ( setsid podman stop --time 3 "$(cat "$rundir/cid")" </dev/null >/dev/null 2>&1 & )
    else
        kill -TERM "$box_pid" 2>/dev/null
    fi
}
trap box_stop HUP INT TERM
"${box[@]}" <&0 &
box_pid=$!

# A trapped signal returns from wait before the box has ended: wait again,
# and leave with the box's own status, as exec did.
status=0
while kill -0 "$box_pid" 2>/dev/null; do
    wait "$box_pid" && status=0 || status=$?
done
exit "$status"
