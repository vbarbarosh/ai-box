#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

# The workspace is the directory you ran this from, handed to the box
# read-write as /app. From $HOME that would be every dotfile, key and
# repository at once -- and so would any directory that contains $HOME,
# or / itself. Compare resolved paths, so a symlink cannot slip past.
workspace=$(realpath "$PWD")
home=$(realpath "$HOME")

if test "$workspace" = /; then
    echo "error: refusing to mount / as the workspace" >&2
    exit 1
fi
case "$home/" in
    "$workspace"/*)
        echo "error: $workspace contains your home directory ($home);" >&2
        echo "       running from here would hand every dotfile and key to the box." >&2
        exit 1 ;;
esac

# Fail fast when the image is not built. Without this podman treats `ai-box` as
# a short name and tries to pull it from a registry, which on a host with
# docker.io in registries.conf looks like a hang and leaves a half-made
# container behind when interrupted.
if ! podman image exists ai-box; then
    echo "error: no 'ai-box' image on this host -- build it first:" >&2
    echo "         $scriptdir/build" >&2
    echo "       (bin/missings reports what else may be absent)" >&2
    exit 1
fi

# Everything the box keeps between runs lives in this repo, under data/:
# agent state, the shared image store, the build stamp. This is not an app you
# install once -- you pull the repo and rebuild it, often more than once a day
# -- so its state belongs beside the tree it was built from, where one `rm -rf`
# clears it and nothing is left anywhere else on the host. Anchored to the
# script, not to $PWD, so the box finds the same state from any workspace.
#
# Kept apart from the host user's own dotfiles either way: the box logs in,
# keeps its history and rewrites its config without touching whatever you run
# outside it. (Running bin/run from this repo therefore shows the box its own
# state at /app/data -- the same files, not a copy.)
data="$(dirname "$scriptdir")/data"

# Undotted on this side of the mount: nothing here is hidden from the person
# who owns it, and `ls data/` should show what the box is keeping. They land
# on their usual dotted names inside the box.
#
# Bind-mounting a path that does not exist makes a directory of it, and the
# agents want files. Create them empty rather than let that happen.
mkdir -p "$data/codex" "$data/claude"
touch "$data/codex.json"
touch "$data/claude.json"

opts=()

# Read-only, mounted over the read-write workspace.
if test -e "$workspace/.git"; then
    opts+=(-v "$workspace/.git:/app/.git:ro")
fi

# Secrets never enter the box: every .env and .env.* in the workspace is
# replaced with /dev/null -- the same set .gitignore keeps out of git. The
# committed templates (.env.example and friends) hold no secrets and stay
# visible, or git inside the box would report them as emptied.
# AI_BOX_MASK adds more names, space-separated, relative to the workspace:
#   AI_BOX_MASK="credentials.json service-account.pem" bin/run
shopt -s nullglob dotglob
for f in "$workspace"/.env "$workspace"/.env.* ${AI_BOX_MASK:-}; do
    f="${f#"$workspace"/}"
    case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac
    test -f "$workspace/$f" || continue
    opts+=(-v "/dev/null:/app/$f:ro")
done
shopt -u nullglob dotglob

# Mounted when present, so this script still runs on a machine that has not
# set them up. An absent path would otherwise be created as an empty
# directory.
if test -e "$HOME/repos"; then
    opts+=(-v "$HOME/repos:/repos:ro")
fi

opts+=(-v "$data/codex.json:/home/ubuntu/.codex.json")
opts+=(-v "$data/claude.json:/home/ubuntu/.claude.json")
opts+=(-v "$data/codex:/home/ubuntu/.codex")
opts+=(-v "$data/claude:/home/ubuntu/.claude")

# An image store shared in from the host: `docker run <image>` inside the box
# then needs no pull and no network. Fill it with
#   podman --root <this repo>/data/images pull alpine:latest
#
# Deliberately not :ro. Building FROM an image that lives only in this store
# makes the inner engine create and remove a transient mountpoint inside it
# ($store/overlay/$layer/merged), and read-only turns every such `docker build`
# into "removing mount point ...: read-only file system". Only those transient
# mountpoints are written; the images themselves are left alone.
if test -d "$data/images"; then
    opts+=(-v "$data/images:/var/lib/shared")
fi

# Limits on the box as a whole -- the inner engine has cgroups disabled, so
# nothing inside can limit itself, and without these a runaway inner build
# takes the host down with it. Each applies only when the matching cgroup
# controller is delegated to your session (systemd does that by default on
# current Ubuntu; bin/missings reports it). Override with an environment
# variable; 0 means no limit.
#
#   AI_BOX_PIDS    default 4096
#   AI_BOX_MEMORY  default three quarters of the host's RAM
#   AI_BOX_CPUS    default unlimited
controllers=$(cat "/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers" 2>/dev/null || true)
delegated () { case " $controllers " in *" $1 "*) return 0 ;; esac; return 1; }

pids=${AI_BOX_PIDS:-4096}
memory=${AI_BOX_MEMORY:-$(awk '/^MemTotal:/ { printf "%dm", $2 * 3 / 4 / 1024 }' /proc/meminfo)}
cpus=${AI_BOX_CPUS:-0}

if test "$pids" != 0 && delegated pids; then
    opts+=(--pids-limit "$pids")
fi
if test "$memory" != 0 && delegated memory; then
    opts+=(--memory "$memory")
fi
if test "$cpus" != 0 && delegated cpu; then
    opts+=(--cpus "$cpus")
fi

# A real init as PID 1: it reaps the orphans that daemonized services and
# agent subprocesses leave behind, and forwards SIGTERM so `podman stop` ends
# the box at once instead of after its full grace period. Podman looks for
# catatonit in its own helper directory; a distribution that installs it
# elsewhere gets the path spelled out. No catatonit, no --init: the box still
# runs, with bash reaping nothing.
if test -x /usr/libexec/podman/catatonit; then
    opts+=(--init)
elif command -v catatonit >/dev/null 2>&1; then
    opts+=(--init --init-path "$(command -v catatonit)")
fi

# A terminal only when there is one: bin/missings --deep and CI call this
# with stdin redirected, and asking for a tty there is a warning at best.
tty=()
if test -t 0; then
    tty=(-t)
fi

# What each of the flags below is for:
#
#   --userns=keep-id:uid=1000,gid=1000 + --user 0
#       ubuntu inside is you outside, so /app and the agent state mounts are
#       writable and anything written lands owned by you, not by root. The
#       entrypoint still starts as root and setpriv's down.
#   --shm-size=2g
#       Chrome and Playwright need more than the default 64m.
#   --device /dev/fuse
#       The inner overlay driver. Native overlayfs cannot stack on the box's
#       own overlay upperdir, so the inner engine uses fuse-overlayfs.
#   --device /dev/net/tun
#       Uplink for the inner network namespace.
#   --security-opt unmask=ALL
#       Two reasons. The inner runtime writes /proc/sys/net/ipv4/ping_group_range,
#       which is read-only by default; and it mounts a fresh /proc for every
#       inner container, which the kernel refuses while any part of the box's
#       own /proc is masked. So ALL, not a narrower list -- a partial unmask
#       fixes the first and not the second. In rootless mode the kernel still
#       enforces the real uid on every one of those paths.
#   --security-opt seccomp=unconfined
#       The inner runtime calls sethostname(2) in its own UTS namespace.
#
# No --privileged and no docker socket: the box is rootless and unprivileged,
# and nothing it runs can reach the host.

exec podman run --rm -i "${tty[@]}" \
    --pull=never \
    --shm-size=2g \
    "${opts[@]}" \
    -v "$workspace:/app" \
    --userns=keep-id:uid=1000,gid=1000 \
    --user 0 \
    --device /dev/fuse \
    --device /dev/net/tun \
    --security-opt label=disable \
    --security-opt unmask=ALL \
    --security-opt seccomp=unconfined \
    ai-box "$@"
