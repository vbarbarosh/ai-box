#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

# The workspace is the directory you ran this from, handed to the box
# read-write as /app. From $HOME that would be every dotfile, key and
# repository at once -- and so would any directory that contains $HOME,
# or / itself. Compare resolved paths, so a symlink cannot slip past.
workspace=$(realpath "$PWD")
home=$(realpath "$HOME")

if test "$workspace" = /; then
    echo "error: refusing to mount / as the workspace" >&2
    exit 1
fi
case "$home/" in
    "$workspace"/*)
        echo "error: $workspace contains your home directory ($home);" >&2
        echo "       running from here would hand every dotfile and key to the box." >&2
        exit 1 ;;
esac

# Your ssh-agent stays outside. podman passes no variable it is not given, so
# SSH_AUTH_SOCK never enters; but a mount that holds the socket hands it in,
# and the box signs with every key the agent holds. Read-only does not help.
agent=
if test -S "${SSH_AUTH_SOCK:-}"; then
    agent=$(realpath "$SSH_AUTH_SOCK")
fi
refuse_agent () {
    case "$agent" in
        "$2"/*)
            echo "error: $1 ($2) holds your ssh-agent's socket ($agent);" >&2
            echo "       mounted, it would let the box use every key the agent holds." >&2
            exit 1 ;;
    esac
}
refuse_agent "the workspace" "$workspace"

# Fail fast when the image is not built. Without this podman treats `ai-box` as
# a short name and tries to pull it from a registry, which on a host with
# docker.io in registries.conf looks like a hang and leaves a half-made
# container behind when interrupted.
if ! podman image exists ai-box; then
    echo "error: no 'ai-box' image on this host -- build it first:" >&2
    echo "         $scriptdir/build" >&2
    echo "       (bin/self-check reports what else may be absent)" >&2
    exit 1
fi

# Everything the box keeps between runs lives in this repo, under data/:
# agent state, the shared image store, the build stamp. This is not an app you
# install once -- you pull the repo and rebuild it, often more than once a day
# -- so its state belongs beside the tree it was built from, where one `rm -rf`
# clears it and nothing is left anywhere else on the host. Anchored to the
# script, not to $PWD, so the box finds the same state from any workspace.
#
# Kept apart from the host user's own dotfiles either way: the box logs in,
# keeps its history and rewrites its config without touching whatever you run
# outside it. (Running bin/run from this repo therefore shows the box its own
# state at /app/data -- the same files, not a copy.)
data="$(dirname "$scriptdir")/data"

# Undotted on this side of the mount: nothing here is hidden from the person
# who owns it, and `ls data/` should show what the box is keeping. They land
# on their usual dotted names inside the box.
#
# Bind-mounting a path that does not exist makes a directory of it, and the
# agents want files. Create them as `{}` rather than let that happen: an
# empty one is not JSON, and claude reports it corrupted ("Unexpected EOF").
mkdir -p "$data/codex" "$data/claude"
test -s "$data/codex.json" || echo '{}' > "$data/codex.json"
test -s "$data/claude.json" || echo '{}' > "$data/claude.json"

# The browsers, the whisper model, Chrome and both agent CLIs are not in the
# image: bin/build fills data/extras with them (notes/extras.md), the agents
# first. Without the agents there is nothing to start; without the rest the
# box starts, and says so once, since a broken browser must not keep you from
# your agents.
if ! test -x "$data/extras/npm/current/bin/claude"; then
    echo "error: no agent CLIs in $data/extras -- fill it with:" >&2
    echo "         $scriptdir/build" >&2
    echo "       (its whole output goes to $data/logs/)" >&2
    exit 1
fi
if ! test -f "$data/extras/versions"; then
    echo "warning: the last fill of $data/extras did not finish: browsers, Chrome" >&2
    echo "         or the whisper model may be missing; see $data/logs/" >&2
fi

opts=()

# Short-lived files of this run: the container's id, and with GIT=commit the
# relay scripts and their sockets. Gone when bin/run ends.
rundir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/ai-box.XXXXXX")
relays=()
cleanup () {
    if test "${#relays[@]}" -gt 0; then
        kill "${relays[@]}" 2>/dev/null || true
    fi
    rm -rf "$rundir"
}
trap cleanup EXIT

# Read-only, mounted over the read-write workspace, always: a box with write
# access to .git can rewrite history, move or delete any branch, drop stashes.
# GIT=commit gives the agent commit, push and pull through the host instead;
# see the relays below.
case "${GIT:-}" in
    "") git_relays= ;;
    commit) git_relays=1 ;;
    rw)
        echo "error: GIT=rw is gone: .git stays read-only, and GIT=commit" >&2
        echo "       commits, pushes and pulls through the host" >&2
        exit 1 ;;
    *)
        echo "error: GIT=$GIT; the only value is commit" >&2
        exit 1 ;;
esac
for name in AI_BOX_MASK AI_BOX_PIDS AI_BOX_MEMORY AI_BOX_CPUS; do
    if test -n "${!name+set}"; then
        echo "error: $name is gone: use ${name#AI_BOX_}" >&2
        exit 1
    fi
done
if test -e "$workspace/.git"; then
    opts+=(-v "$workspace/.git:/app/.git:ro")
fi

# Secrets never enter the box: every .env and .env.* in the workspace is
# replaced with /dev/null -- the same set .gitignore keeps out of git. The
# committed templates (.env.example and friends) hold no secrets and stay
# visible, or git inside the box would report them as emptied.
# MASK adds more names, space-separated, relative to the workspace:
#   MASK="credentials.json service-account.pem" bin/run
masked_paths=()
shopt -s nullglob dotglob
for f in "$workspace"/.env "$workspace"/.env.* ${MASK:-}; do
    f="${f#"$workspace"/}"
    case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac
    test -f "$workspace/$f" || continue
    opts+=(-v "/dev/null:/app/$f:ro")
    masked_paths+=("$f")
done
shopt -u nullglob dotglob

# GIT=commit: the box holds no key and cannot write .git, so the host does the
# git work. `commit`, `push` and `pull` inside the box each connect to a socket
# the host listens on, and the host runs a fixed script in the workspace, for
# the branch checked out when the box started:
#   commit   a patch and a message from the box, applied on HEAD and
#            committed: as you, with your hooks; your staging left alone
#   push     git push --no-follow-tags origin <branch>:<branch>
#   pull     git fetch of <branch>, then git merge; a conflict is undone
# No force, no other branch, no tags, no rewriting. The relays end with the box.
if test -n "$git_relays"; then
    branch=$(git -C "$workspace" symbolic-ref --quiet --short HEAD || true)
    if ! test -d "$workspace/.git"; then
        echo "error: GIT=commit, but $workspace/.git is not a directory" >&2
        echo "       (a linked worktree or a submodule checkout points outside" >&2
        echo "       the workspace, where the box cannot follow)" >&2
        exit 1
    elif test -z "$branch"; then
        echo "error: GIT=commit, but HEAD is detached; check out a branch first" >&2
        exit 1
    elif ! command -v socat >/dev/null 2>&1; then
        echo "error: GIT=commit needs socat on the host (bin/configure)" >&2
        exit 1
    fi
    # The scripts stay outside the box; only box/ goes in, read-only, for the
    # sockets and the branch name.
    relaydir=$rundir/git
    mkdir -p "$relaydir/box"
    echo "$branch" > "$relaydir/box/branch"
    # relay <name> < body: serves the script on box/<name>.sock. Each
    # connection runs it once: the box's bytes on its stdin, its output back.
    relay () {
        local name=$1
        {
            echo '#!/bin/bash'
            printf 'workspace=%q\n' "$workspace"
            printf 'branch=%q\n' "$branch"
            printf 'masked_paths=('
            printf ' %q' "${masked_paths[@]}"
            printf ' )\n'
            cat <<'EOF'
export GIT_TERMINAL_PROMPT=0 GIT_LITERAL_PATHSPECS=1
unset GIT_INDEX_FILE
cd "$workspace" || exit 1
check_branch () {
    local current
    current=$(git symbolic-ref --quiet --short HEAD)
    if test "$current" != "$branch"; then
        echo "the box was started on $branch, and the host is on ${current:-a detached HEAD} now"
        return 1
    fi
}
EOF
            cat
        } > "$relaydir/$name"
        chmod 700 "$relaydir/$name"
        # setsid: no terminal to prompt on, so a locked key fails the push
        # instead of asking for a passphrase over the box's own screen.
        # -t: the box closes its side once it has sent; the answer may take
        # as long as the hooks or the network do.
        setsid socat -t 3600 "UNIX-LISTEN:$relaydir/box/$name.sock,fork,mode=600" "EXEC:$relaydir/$name" \
            </dev/null >/dev/null 2>&1 &
        relays+=($!)
        for _ in $(seq 20); do
            test -S "$relaydir/box/$name.sock" && break
            sleep 0.05
        done
    }
    relay commit <<'EOF'
# A message ended by a NUL, then the patch. The patch goes on HEAD in a scratch
# index, so neither your staging nor the working tree is read or changed; then
# git commit, with your hooks, and your index follows for the paths it touched.
# A masked file is refused: the box sees it emptied.
commit () {
    local message= tempdir path masked_path status paths=()
    IFS= read -r -d '' message || true
    tempdir=$(mktemp -d)
    cat > "$tempdir/patch"
    if test -z "$message" || ! test -s "$tempdir/patch"; then
        echo "commit: needs a message and a patch"
        rm -rf "$tempdir"
        return 1
    fi
    check_branch || { rm -rf "$tempdir"; return 1; }
    export GIT_INDEX_FILE="$tempdir/index"
    git read-tree HEAD
    if ! git apply --cached "$tempdir/patch"; then
        echo "commit: the patch does not apply to $branch as it is now"
        rm -rf "$tempdir"
        return 1
    fi
    while IFS= read -r -d '' path; do
        for masked_path in "${masked_paths[@]}"; do
            if test "$path" = "$masked_path"; then
                echo "commit: $path is hidden from the box; commit it yourself"
                rm -rf "$tempdir"
                return 1
            fi
        done
        paths+=("$path")
    done < <(git diff --cached --name-only --no-renames -z HEAD)
    if test "${#paths[@]}" -eq 0; then
        echo "commit: the patch changes nothing"
        rm -rf "$tempdir"
        return 1
    fi
    git commit --no-edit -F - <<<"$message"
    status=$?
    unset GIT_INDEX_FILE
    if test "$status" = 0; then
        git reset -q -- "${paths[@]}"
    fi
    rm -rf "$tempdir"
    return "$status"
}
commit 2>&1
echo "commit: exit $?"
EOF
    relay push <<'EOF'
git push --no-follow-tags origin "refs/heads/$branch:refs/heads/$branch" </dev/null 2>&1
echo "push: exit $?"
EOF
    relay pull <<'EOF'
pull () {
    check_branch || return 1
    git fetch --no-tags --no-recurse-submodules origin "+refs/heads/$branch:refs/remotes/origin/$branch" || return
    if git merge --no-edit "refs/remotes/origin/$branch"; then
        return 0
    fi
    # git merge refuses before it starts (local changes in the way) or stops
    # halfway with conflicts; only the second leaves MERGE_HEAD.
    git rev-parse --quiet --verify MERGE_HEAD >/dev/null || return 1
    local conflicts
    conflicts=$(git diff --name-only --diff-filter=U)
    git merge --abort
    echo
    echo "pull: origin/$branch conflicts with $branch in:"
    sed 's/^/  /' <<<"$conflicts"
    echo "pull: the merge is undone, the tree is as it was. Stop here and ask the author how to resolve it."
    return 2
}
pull </dev/null 2>&1
echo "pull: exit $?"
EOF
    opts+=(-v "$relaydir/box:/run/git:ro")
    echo "ai-box: commit, push and pull work on $branch, through the host; .git is read-only" >&2
fi

# Mounted when present, so this script still runs on a machine that has not
# set them up. An absent path would otherwise be created as an empty
# directory. REPOS names another folder for /repos; set but empty, no /repos.
#   REPOS=~/w bin/run claude
# Set but wrong is an error, as with AGENTDIR. Read-only, but never /, $HOME or
# anything containing it: the box would read every key there.
repos=
if test -z "${REPOS+set}"; then
    if test -e "$HOME/repos"; then
        repos=$(realpath "$HOME/repos")
        refuse_agent "the default ~/repos" "$repos"
        opts+=(-v "$HOME/repos:/repos:ro")
    fi
elif test -n "$REPOS"; then
    if ! test -d "$REPOS"; then
        echo "error: REPOS is not a directory: $REPOS" >&2
        exit 1
    fi
    repos=$(realpath "$REPOS")
    case "$home/" in
        "$repos"/*)
            echo "error: REPOS ($repos) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$repos" = /; then
        echo "error: refusing to mount / as REPOS" >&2
        exit 1
    fi
    refuse_agent REPOS "$repos"
    opts+=(-v "$repos:/repos:ro")
fi

# Read-only is not hidden: every repository in /repos keeps its .env and
# .env.* out as the workspace does, and a workspace inside /repos (a machine
# that starts the box in a folder of REPOS) is masked there as at /app, MASK
# included. Symlinked folders are skipped: their targets are not mounted.
if test -n "$repos"; then
    case "$workspace/" in
        "$repos"/*) workspace_in_repos=${workspace#"$repos"/} ;;
        *) workspace_in_repos= ;;
    esac
    shopt -s nullglob dotglob
    for dir in "$repos"/*/; do
        dir=${dir%/}
        test -L "$dir" && continue
        test "${dir#"$repos"/}" = "$workspace_in_repos" && continue
        for f in "$dir"/.env "$dir"/.env.*; do
            case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac
            test -f "$f" || continue
            opts+=(-v "/dev/null:/repos/${f#"$repos"/}:ro")
        done
    done
    shopt -u nullglob dotglob
    if test -n "$workspace_in_repos"; then
        for f in "${masked_paths[@]}"; do
            opts+=(-v "/dev/null:/repos/$workspace_in_repos/$f:ro")
        done
    fi
fi

# The agent's folder, a Visual Notes note, read-write, so the agent answers in
# it: AGENTDIR names it and the box sees it as /agentdir.
#   AGENTDIR=~/w/kb/app-visual-notes/data/notes/<id> bin/run claude
# Set but wrong is an error, not a box without the note. The same guard as the
# workspace: it is writable, so never /, $HOME or anything containing it.
agentdir=${AGENTDIR:-}
if test -n "$agentdir"; then
    if ! test -d "$agentdir"; then
        echo "error: AGENTDIR is not a directory: $agentdir" >&2
        exit 1
    fi
    agentdir=$(realpath "$agentdir")
    case "$home/" in
        "$agentdir"/*)
            echo "error: AGENTDIR ($agentdir) contains your home directory ($home)" >&2
            exit 1 ;;
    esac
    if test "$agentdir" = /; then
        echo "error: refusing to mount / as AGENTDIR" >&2
        exit 1
    fi
    refuse_agent AGENTDIR "$agentdir"
    opts+=(-v "$agentdir:/agentdir")
fi

opts+=(-v "$data/codex.json:/home/ubuntu/.codex.json")
opts+=(-v "$data/claude.json:/home/ubuntu/.claude.json")
opts+=(-v "$data/codex:/home/ubuntu/.codex")
opts+=(-v "$data/claude:/home/ubuntu/.claude")

# :O, an overlay: the host's folder is the lower layer and no box writes it,
# while a box may still write there -- a project's own `npx playwright
# install` -- into a layer that ends with the box, as writes into the image
# do. bin/build only adds folders and moves the `current` links while boxes
# run; it removes a version three days after it stopped being current.
opts+=(-v "$data/extras:/opt/extras:O")

# An image store shared in from the host: `docker run <image>` inside the box
# then needs no pull and no network. Fill it with
#   bin/images mysql:8.0
# from the host: a pull from inside lands in the box's own store and goes with
# it.
#
# Deliberately not :ro. Building FROM an image that lives only in this store
# makes the inner engine create and remove a transient mountpoint inside it
# ($store/overlay/$layer/merged), and read-only turns every such `docker build`
# into "removing mount point ...: read-only file system". Only those transient
# mountpoints are written; the images themselves are left alone.
if test -d "$data/images"; then
    opts+=(-v "$data/images:/var/lib/shared")
fi

# Limits on the box as a whole -- the inner engine has cgroups disabled, so
# nothing inside can limit itself, and without these a runaway inner build
# takes the host down with it. Each applies only when the matching cgroup
# controller is delegated to your session (systemd does that by default on
# current Ubuntu; bin/self-check reports it). Override with an environment
# variable; 0 means no limit.
#
#   PIDS    default 4096
#   MEMORY  default three quarters of the host's RAM
#   CPUS    default unlimited
controllers=$(cat "/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers" 2>/dev/null || true)
is_delegated () { case " $controllers " in *" $1 "*) return 0 ;; esac; return 1; }

pids=${PIDS:-4096}
memory=${MEMORY:-$(awk '/^MemTotal:/ { printf "%dm", $2 * 3 / 4 / 1024 }' /proc/meminfo)}
cpus=${CPUS:-0}

if test "$pids" != 0 && is_delegated pids; then
    opts+=(--pids-limit "$pids")
fi
if test "$memory" != 0 && is_delegated memory; then
    opts+=(--memory "$memory")
fi
if test "$cpus" != 0 && is_delegated cpu; then
    opts+=(--cpus "$cpus")
fi

# A real init as PID 1: it reaps the orphans that daemonized services and
# agent subprocesses leave behind, and forwards SIGTERM so `podman stop` ends
# the box at once instead of after its full grace period. Podman looks for
# catatonit in its own helper directory; a distribution that installs it
# elsewhere gets the path spelled out. No catatonit, no --init: the box still
# runs, with bash reaping nothing.
if test -x /usr/libexec/podman/catatonit; then
    opts+=(--init)
elif command -v catatonit >/dev/null 2>&1; then
    opts+=(--init --init-path "$(command -v catatonit)")
fi

# A terminal only when there is one: bin/self-check --deep and CI call this
# with stdin redirected, and asking for a tty there is a warning at best.
tty=()
if test -t 0; then
    tty=(-t)
fi

# What each of the flags below is for:
#
#   --userns=keep-id:uid=1000,gid=1000 + --user 0
#       ubuntu inside is you outside, so /app and the agent state mounts are
#       writable and anything written lands owned by you, not by root. The
#       entrypoint still starts as root and setpriv's down.
#   --shm-size=2g
#       Chrome and Playwright need more than the default 64m.
#   --device /dev/fuse
#       The inner overlay driver. Native overlayfs cannot stack on the box's
#       own overlay upperdir, so the inner engine uses fuse-overlayfs.
#   --device /dev/net/tun
#       Uplink for the inner network namespace.
#   --security-opt unmask=ALL
#       Two reasons. The inner runtime writes /proc/sys/net/ipv4/ping_group_range,
#       which is read-only by default; and it mounts a fresh /proc for every
#       inner container, which the kernel refuses while any part of the box's
#       own /proc is masked. So ALL, not a narrower list -- a partial unmask
#       fixes the first and not the second. In rootless mode the kernel still
#       enforces the real uid on every one of those paths.
#   --security-opt seccomp=unconfined
#       The inner runtime calls sethostname(2) in its own UTS namespace.
#   --sysctl net.ipv4.ping_group_range=1000 1000
#       ping without a raw socket. Podman's default for this is "0 0" -- only
#       gid 0 may open an unprivileged ICMP socket -- and the box runs as
#       ubuntu, so ping would fail on the socket instead. Both ends have to be
#       a gid that maps inside the user namespace, which is what keep-id below
#       guarantees for 1000; a wide range like 0-2147483647 is refused by the
#       runtime. Narrower than --cap-add=NET_RAW, which would hand every
#       process in the box raw packet access for the sake of one command.
#
# No --privileged and no docker socket: the box is rootless and unprivileged,
# and nothing it runs can reach the host -- save the GIT=commit relays, each
# running one fixed script there.

box=(podman run --rm -i "${tty[@]}" \
    --cidfile "$rundir/cid" \
    --pull=never \
    --shm-size=2g \
    "${opts[@]}" \
    -v "$workspace:/app" \
    "--userns=keep-id:uid=1000,gid=1000" \
    --user 0 \
    --device /dev/fuse \
    --device /dev/net/tun \
    --security-opt label=disable \
    --security-opt unmask=ALL \
    --security-opt seccomp=unconfined \
    --sysctl net.ipv4.ping_group_range="1000 1000" \
    ai-box "$@")

# The box ends with bin/run. `podman run` is only a client: the container
# runs under conmon, and when podman run is killed the container runs on.
# That is how an agent outlived the shell Visual Notes had ended (SIGHUP to
# the shell, SIGTERM to the rest, SIGKILL 3 s later) and went on writing to
# its note beside the next agent. So podman runs in the background here, and
# SIGHUP, SIGTERM or SIGINT to bin/run stops the container: SIGTERM to its
# init, SIGKILL 3 s later. The stop is detached, in a session of its own, so
# it finishes when bin/run is killed in the middle of it. Before the id file
# is written there is no container yet, and the signal goes to podman run.
# Ctrl-C with a terminal never gets here: the tty is raw and the box sees
# the keystroke. Only a bare SIGKILL to bin/run leaves the box running.
stop_box () {
    trap '' HUP INT TERM
    if test -s "$rundir/cid"; then
        ( setsid podman stop --time 3 "$(cat "$rundir/cid")" </dev/null >/dev/null 2>&1 & )
    else
        kill -TERM "$box_pid" 2>/dev/null
    fi
}
trap stop_box HUP INT TERM
"${box[@]}" <&0 &
box_pid=$!

# A trapped signal returns from wait before the box has ended: wait again,
# and leave with the box's own status, as exec did.
status=0
while kill -0 "$box_pid" 2>/dev/null; do
    wait "$box_pid" && status=0 || status=$?
done
exit "$status"
