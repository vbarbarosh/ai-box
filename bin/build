#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

cd $scriptdir/..

# Everything a build prints -- podman build, the warming, extras-fill -- also
# goes to data/logs/build-<Chisinau time>.log, so a failure can be read back
# whole after the terminal is gone.
mkdir -p data/logs
log=$PWD/data/logs/build-`TZ=Europe/Chisinau date +%Y%m%d_%H%M%S`.log
exec > >(tee -a $log) 2>&1
echo "$scriptname: started `TZ=Europe/Chisinau date '+%F %T %Z'`; whole output in $log"
on_exit () {
    status=$?
    if test $status = 0; then
        echo "$scriptname: done; log $log"
    else
        echo "$scriptname: FAILED (exit $status); whole output in $log"
    fi
}
trap on_exit EXIT

# Every binary the Dockerfile fetches outside apt -- Node, yt-dlp,
# oxipng, ImageMagick, Chrome -- is the x86_64 build. On another architecture
# the build would run the whole package layer and then fail at the first
# checksum with a message that does not say why. Say why here instead.
if test "$(uname -m)" != x86_64; then
    echo "error: the image is x86_64-only and this host is $(uname -m)." >&2
    exit 1
fi

# One ISO week drives every refresh: the token expires the package layer in the
# Dockerfile, and the base image moves on the same day. The stamp holds the week
# of the last finished build, so repeat builds inside one week reuse every
# cached layer and ask no registry for a newer Ubuntu.
ubuntu_refresh="$(date -u +%G-W%V)"
stamp="$(dirname "$scriptdir")/data/refresh"

pull=
if [ "$(cat "$stamp" 2>/dev/null)" != "$ubuntu_refresh" ]; then
    pull=--pull
fi

# An empty $pull must expand to no argument at all, so it stays unquoted.
podman build $pull \
    --build-arg "UBUNTU_REFRESH=${ubuntu_refresh}" \
    . \
    -t ai-box

mkdir -p "$(dirname $stamp)"
echo "$ubuntu_refresh" > "$stamp"

# bin/run maps your uid into the box (--userns=keep-id), which is not the
# mapping the store is written with. On native overlay podman reconciles the
# two by copying: containers/storage lays a layer over the image and chowns
# every path through the mount, which copies up every file under it. So the
# bill is the WHOLE image -- not the layers that changed -- every time the
# image id changes, which on this one is ~8.5 GB and about two minutes, and
# looks exactly like a hang.
#
# Rootless there is no fast path. The overlay driver's idmapped-mount probe
# returns false whenever euid is not 0, before it asks the kernel, so this
# does not age out with a newer kernel or podman. fuse-overlayfs does skip
# the copy, but breaks nested `docker build` against the shared image store.
# Building the image under the mapping does not help either: buildah commits
# every layer in the store's mapping whatever --userns-uid-map says, so the
# copy just moves inside the build, once per step. Both measured -- see
# notes/idmap-2026-09-04.md.
#
# Do it here, once, while you are already waiting for a build, rather than in
# front of whoever runs bin/run next.

graphroot=$(podman info --format '{{.Store.GraphRoot}}' 2>/dev/null || echo "")

# Free space on the store's filesystem, in bytes. Every file the copy touches
# changes owner, so little of it can be hardlinked and the fall in free space
# tracks the copy closely -- 8.5 GB for this image, measured. It is a liveness
# signal, not a measure of how much is left, so what is reported below is
# written, not copied.
free_bytes () {
    test -n "$graphroot" || { echo 0; return; }
    df -kP "$graphroot" 2>/dev/null | awk 'NR==2 {print $4 * 1024}'
}

human () {
    awk -v b="$1" 'BEGIN {
        split("B KB MB GB TB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf "%.1f %s", b, u[i]
    }'
}

podman run --rm \
    --userns=keep-id:uid=1000,gid=1000 \
    --user 0 \
    --entrypoint true \
    ai-box &
warm_pid=$!

start=$(date +%s)

# Ctrl-C here is not a failed build: the image is built and tagged by now, and
# only the warming is unfinished. Say so, rather than leaving the bare
# "signal: interrupt" that podman prints, which reads like the build broke.
on_interrupt () {
    trap - INT TERM
    if kill -0 $warm_pid 2>/dev/null; then
        # Signal descendants too: killing only the direct child can leave its
        # workers running, still writing into the store. Then give it a few
        # seconds to unwind cleanly before insisting.
        command -v pkill >/dev/null 2>&1 && pkill -TERM -P $warm_pid 2>/dev/null || true
        kill -TERM $warm_pid 2>/dev/null || true

        for _ in 1 2 3; do
            kill -0 $warm_pid 2>/dev/null || break
            sleep 1
        done

        if kill -0 $warm_pid 2>/dev/null; then
            command -v pkill >/dev/null 2>&1 && pkill -KILL -P $warm_pid 2>/dev/null || true
            kill -KILL $warm_pid 2>/dev/null || true
        fi

        wait $warm_pid 2>/dev/null || true
    fi
    test -t 1 && printf '\r\033[K' || true
    echo
    echo "warming interrupted after $(( $(date +%s) - start ))s."
    echo "The ai-box image is built and usable -- only the id-mapped copy is"
    echo "unfinished. Re-run $scriptname to finish it here, or just use bin/run:"
    echo "it will do the remaining work on its first run instead."
    exit 130
}
trap on_interrupt INT TERM
before=$(free_bytes)
shown=

# Stay quiet on a host that does not need the copy: it finishes in well under
# the two seconds before anything is printed.
while kill -0 $warm_pid 2>/dev/null; do
    sleep 1
    elapsed=$(( $(date +%s) - start ))
    test "$elapsed" -ge 2 || continue

    if test -z "$shown"; then
        echo "copying the image to match bin/run's id mapping (all of it,"
        echo "every build -- this step is not incremental)..."
        shown=1
    fi

    written=$(( before - $(free_bytes) ))
    test "$written" -ge 0 2>/dev/null || written=0

    if test "$written" -gt 0; then
        rate=$(( written / elapsed ))
        line=$(printf '  %s written, %ds elapsed (%s/s)' \
            "$(human $written)" "$elapsed" "$(human $rate)")
    else
        line=$(printf '  %ds elapsed' "$elapsed")
    fi

    if test -t 1; then
        printf '\r\033[K%s' "$line"
    else
        echo "$line"
    fi
done

# errexit-safe: a killed child must reach the checks below, not abort here.
warm_status=0
wait $warm_pid || warm_status=$?
trap - INT TERM

test -z "$shown" || { test -t 1 && printf '\r\033[K' || true; }

case "$warm_status" in
    0)   if test -n "$shown"; then
             final=$(( before - $(free_bytes) ))
             test "$final" -ge 0 2>/dev/null || final=0
             echo "  warmed in $(( $(date +%s) - start ))s ($(human $final) written)"
         fi ;;
    130|$((128+2))|$((128+15)))
         # Signalled without our trap running (e.g. SIGINT delivered straight
         # to the child by the terminal's process group).
         echo "warming interrupted. The ai-box image is built and usable;"
         echo "re-run $scriptname to finish the id-mapped copy, or let bin/run"
         echo "do it on first run."
         exit 130 ;;
    *)   echo "warning: warming exited with status $warm_status." >&2
         echo "         The image is built; bin/run will do this work on first run." >&2
         exit "$warm_status" ;;
esac

# The browsers, the whisper model, Chrome and the two agent CLIs live in
# data/extras, not in the image (notes/extras.md). The new image fills it:
# what is there at the right version costs nothing, so a daily build fetches
# only a new Claude or Codex, and the first build of a week (REFRESH) also a
# new Chrome. Its own week stamp, written when the fill succeeds, so a failed
# fill takes the new Chrome on the next build. Same mapping as bin/run, so the
# files land owned by you, and the id-mapped copy above is the one this reuses.
# With IMAGE_ID it skips its probes when the image, agents and Chrome are the
# last fill's.
mkdir -p data/extras
refresh=
if test "$(cat data/extras/refresh 2>/dev/null)" != "$ubuntu_refresh"; then
    refresh=1
fi
podman run --rm \
    --pull=never \
    --shm-size=2g \
    --userns=keep-id:uid=1000,gid=1000 \
    --user 1000:1000 \
    -e HOME=/home/ubuntu \
    -e REFRESH=$refresh \
    -e IMAGE_ID=$(podman image inspect --format '{{.Id}}' ai-box) \
    -v "$PWD/data/extras:/opt/extras" \
    --entrypoint /home/ubuntu/bin/extras-fill \
    ai-box

echo "$ubuntu_refresh" > data/extras/refresh

# Each build leaves the previous ai-box untagged, and podman keeps them all.
# Remove them now that the new one is built and filled; podman removes an
# image's build steps with it when no other image shares them. One a container
# still uses, a running box or a stopped one, stays: podman refuses to remove
# it, and the next build tries again.
before=$(free_bytes)
removed=
for id in $(podman images --quiet --no-trunc --filter dangling=true); do
    case "$(podman image inspect --format '{{.NamesHistory}}' $id 2>/dev/null)" in
        *localhost/ai-box:*) ;;
        *) continue ;;
    esac
    short=${id#sha256:}
    short=${short:0:12}
    if out=$(podman rmi $id 2>&1); then
        echo "removed the old image $short"
        removed=1
    elif [[ "$out" == *"in use by a container"* ]]; then
        users=$(podman ps --all --filter ancestor=$id --format '{{.Names}} ({{.Status}})' | paste -sd, - | sed 's/,/, /g')
        echo "kept the old image $short: used by ${users:-a container}; the first build after they are gone removes it"
    else
        echo "warning: could not remove the old image $short: $out" >&2
    fi
done
if test -n "$removed"; then
    freed=$(( $(free_bytes) - before ))
    test "$freed" -ge 0 2>/dev/null || freed=0
    echo "old images removed, $(human $freed) freed"
fi
