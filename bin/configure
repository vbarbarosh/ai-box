#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

BLACK="\e[30m" RED="\e[31m" GREEN="\e[32m" YELLOW="\e[33m" BLUE="\e[34m"
PURPLE="\e[35m" CYAN="\e[36m" WHITE="\e[37m" RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/configure failed${RESET}"
trap 'echo -e "$EXIT_MESSAGE"' EXIT

# Installs everything the host needs to run the box. Idempotent: every step
# checks first, so re-running it is a no-op that reports what is already there.
# `bin/self-check` reports the same set without changing anything.
#
#   bin/configure            install what is missing
#   bin/configure --dry-run  print what it would do, change nothing

dry=
while test $# -gt 0; do
    case "$1" in
        --dry-run|-n) dry=1 ;;
        *) echo "usage: $scriptname [--dry-run]" >&2; exit 1 ;;
    esac
    shift
done

# The subordinate range has to belong to whoever will run the box. Under sudo
# that is $SUDO_USER; as bare root there is nobody to infer, and granting the
# range to root would look like success while leaving the real user unable to
# nest anything. Root is never that user: bin/run's isolation rests on the
# outer podman being rootless, so there is no root-runs-the-box case to
# configure for.
if test "$(id -u)" -eq 0 && test -z "${SUDO_USER-}"; then
    echo "error: running as root with no SUDO_USER." >&2
    echo "       The subordinate id range would be granted to root, not to" >&2
    echo "       the user who will run the box -- and the box is rootless, so" >&2
    echo "       root never runs it. Re-run as that user, or as 'sudo $0'." >&2
    exit 1
fi

# change <description> <command...>
change () {
    local what=$1; shift
    if test -n "$dry"; then
        echo "  would: $what"
        echo "         $*"
    else
        echo "  $what"
        "$@"
    fi
}

if ! command -v apt-get >/dev/null 2>&1; then
    echo "error: this script only knows apt. Install the equivalents of:" >&2
    echo "  podman uidmap crun passt slirp4netns catatonit socat" >&2
    exit 1
fi

# bin/run starts the box with --userns=keep-id:uid=1000,gid=1000, which podman
# takes from 4.3 on. Ubuntu 22.04 ships 3.4.4 (and no passt): stop here with
# that, not halfway through apt on the first package it lacks.
podman_min=4.3
if command -v podman >/dev/null 2>&1; then
    podman_have=$(podman --version 2>/dev/null | awk '{print $3}')
    podman_from="installed"
else
    podman_have=$(apt-cache policy podman 2>/dev/null | awk '$1 == "Candidate:" {print $2}')
    podman_from="the apt version"
fi
if test -z "$podman_have" || test "$podman_have" = "(none)"; then
    echo "error: apt has no podman package; ai-box needs podman $podman_min or newer." >&2
    echo "       Ubuntu 24.04 has it." >&2
    exit 1
fi
if dpkg --compare-versions "$podman_have" lt "$podman_min"; then
    echo "error: podman $podman_have is $podman_from here; ai-box needs $podman_min or newer." >&2
    echo "       $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-This system}") is too old for it: upgrade to Ubuntu 24.04" >&2
    echo "       (sudo do-release-upgrade), then run bin/$scriptname again." >&2
    exit 1
fi

# What the run will change, worked out before any of it: sudo is asked for
# once, up front, and only when a step needs it; a short subordinate range
# stops the run here, before apt.

# passt provides pasta, the userspace network helper podman prefers; slirp4netns
# is the older fallback and is small enough to keep as a spare. catatonit is
# the init bin/run puts at PID 1 of the box. socat carries `commit`, `push`
# and `pull` out of a GIT=commit box to the host.
packages=(podman uidmap crun passt slirp4netns catatonit socat)
packages_missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
        packages_missing+=("$package")
    fi
done

# /dev/fuse is the inner overlay driver; /dev/net/tun is the inner network
# uplink. Both are passed into the box, so both must exist on the host.
modules=("fuse /dev/fuse" "tun /dev/net/tun")
modules_missing=()
for module in "${modules[@]}"; do
    set -- $module
    test -c "$2" || modules_missing+=("$module")
done

# The inner engine carves its own range out of this one. A range shorter than
# 65536 is the setting that breaks nesting, with an opaque newuidmap error.
# Under `sudo bin/configure`, id -un is root -- but the subordinate range has
# to belong to whoever will actually run the box. Guarded above: bare root
# never gets this far.
me=${SUDO_USER:-$(id -un)}
subids_missing=()
for f in /etc/subuid /etc/subgid; do
    n=$(awk -F: -v u="$me" '$1==u {print $3; exit}' "$f" 2>/dev/null || true)
    if test "${n:-0}" -ge 65536 2>/dev/null; then
        continue
    elif test -n "${n:-}"; then
        echo "  $f gives $me only $n ids, and 65536 are needed." >&2
        echo "  Widen it by hand -- rewriting an existing range can collide" >&2
        echo "  with ids already used by containers you have:" >&2
        echo "    sudo sed -i 's/^$me:.*/$me:100000:65536/' $f" >&2
        exit 1
    else
        subids_missing+=("$f")
    fi
done

# The password once, up front, and only when a step will need it; the later
# calls are sudo -n, which fail at once rather than prompt halfway.
changes_count=$(( ${#packages_missing[@]} + ${#modules_missing[@]} + ${#subids_missing[@]} ))
if test -z "$dry" && test "$changes_count" -gt 0 && test "$(id -u)" -ne 0; then
    if ! sudo -n true 2>/dev/null; then
        if test -t 0; then
            echo "This needs sudo to install packages and load kernel modules."
            sudo -v || exit 1
        else
            echo "error: needs sudo, and there is no terminal to authenticate on." >&2
            echo "       Run it from a terminal, or pre-authenticate with 'sudo -v'." >&2
            exit 1
        fi
    fi
fi

echo
echo "packages"
for package in "${packages[@]}"; do
    case " ${packages_missing[*]} " in
        *" $package "*) ;;
        *) echo "  present: $package" ;;
    esac
done
if test "${#packages_missing[@]}" -gt 0; then
    change "apt-get install: ${packages_missing[*]}" sudo -n apt-get install -y "${packages_missing[@]}"
fi

echo
echo "kernel modules"
for module in "${modules[@]}"; do
    set -- $module
    mod=$1; dev=$2
    if test -c "$dev"; then
        echo "  present: $dev"
    else
        change "modprobe $mod" sudo -n modprobe "$mod"
        # Survive a reboot.
        if ! grep -qxs "$mod" /etc/modules-load.d/ai-box.conf; then
            change "persist $mod across reboots" \
                sudo -n tee -a /etc/modules-load.d/ai-box.conf <<<"$mod"
        fi
    fi
done

echo
echo "subordinate ids"
granted=
for f in /etc/subuid /etc/subgid; do
    n=$(awk -F: -v u="$me" '$1==u {print $3; exit}' "$f" 2>/dev/null || true)
    if test "${n:-0}" -ge 65536 2>/dev/null; then
        echo "  present: $f has $n ids for $me"
    else
        # The first free block above every range already in the file, the way
        # useradd picks one. The first account on an Ubuntu install already
        # owns 100000-165535; handing a second account the same block would
        # let each one's containers read and write the other's files.
        first=$(awk -F: '{ e = $2 + $3; if (e > m) m = e } END { print (m > 100000 ? m : 100000) }' "$f" 2>/dev/null || echo 100000)
        last=$((first + 65535))
        case "$f" in
            /etc/subuid) change "grant $me subuids $first-$last" sudo -n usermod --add-subuids "$first-$last" "$me" ;;
            /etc/subgid) change "grant $me subgids $first-$last" sudo -n usermod --add-subgids "$first-$last" "$me" ;;
        esac
        granted=1
    fi
done
if test -n "$granted"; then
    change "reload podman's view of the new range" sudo -n -u "$me" podman system migrate
fi

echo
if test -n "$dry"; then
    echo "dry run: nothing changed"
else
    echo "done -- checking:"
    "$scriptdir/self-check"
fi

EXIT_MESSAGE="${GREEN}bin/configure succeeded${RESET}"
