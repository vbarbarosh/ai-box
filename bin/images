#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

BLACK="\e[30m" RED="\e[31m" GREEN="\e[32m" YELLOW="\e[33m" BLUE="\e[34m"
PURPLE="\e[35m" CYAN="\e[36m" WHITE="\e[37m" RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/images failed${RESET}"

# The shared image store: what `docker run <image>` finds inside the box with
# no pull and no network.
#
#   bin/images                    list what the box will find
#   bin/images mysql:8.0 redis:7  add images to the store
#   bin/images --remove mysql:8.0 take one out again
#
# It has to be filled from out here. An additionalimagestore is read-only to
# containers/storage -- whatever its mount says -- so a pull inside the box
# lands in the box's own graphroot and goes when the box does.
#
# Private registries need no extra work here: `podman login` on this host
# writes an auth file this reads, and the box never sees the credential --
# only the image, already pulled.

data="$(dirname "$scriptdir")/data/images"
store_opts=(--root "$data" --storage-driver overlay)

# Root would write a store the box cannot read: it reads it as you.
test "$(id -u)" -ne 0 || { echo "error: run as the user who runs the box." >&2; exit 1; }

# podman stamps the path it opened the store under into the store's database
# and then refuses every other path -- which is what happens when the repo
# moves, or when the box opens the same files as /var/lib/shared. Nothing an
# image store needs is in there, so it goes after every run.
trap 'rm -rf "$data/db.sql" "$data/libpod"; echo -e "$EXIT_MESSAGE"' EXIT

# mysql:8.0 -> docker.io/library/mysql:8.0, so the stored name is the name the
# box looks for; short names resolve through a different registries.conf there.
ref_from_image () {
    case "$1" in
        */*) case "${1%%/*}" in *.*|*:*) echo "$1" ;; *) echo "docker.io/$1" ;; esac ;;
        *)   echo "docker.io/library/$1" ;;
    esac
}

removal=
case "${1:-}" in
    --remove|-r) removal=1; shift ;;
    -*)          echo "usage: $scriptname [--remove] [image...]" >&2; exit 1 ;;
esac

if test $# -eq 0; then
    if test -d "$data"; then
        podman "${store_opts[@]}" images
        echo
        echo "$(du -sh "$data" | cut -f1) in $data"
    else
        echo "no store yet at $data"
    fi
    EXIT_MESSAGE="${GREEN}bin/images succeeded${RESET}"
    exit 0
fi

# A failed rmi stops here; it never falls through to a pull of the same image.
for image in "$@"; do
    ref=$(ref_from_image "$image")
    if test -n "$removal"; then
        podman "${store_opts[@]}" rmi "$ref"
    else
        podman "${store_opts[@]}" pull "$ref"
    fi
done

EXIT_MESSAGE="${GREEN}bin/images succeeded${RESET}"
