# Secrets never enter the box (bin/run masks .env with /dev/null); keep them
# out of git as well.
.env
.env.*

# Everything the box keeps between runs: the agents' state and logins, the
# shared image store, the build stamp. bin/run and bin/build create it as
# needed; none of it is ours to commit, and a fresh clone starts without it.
/data/

# The dotted originals loose in the tree, from an agent run pointed at this
# repo. What the box keeps is data/claude and data/codex, undotted.
.claude.json
.codex.json
.claude/
.codex/

# Scratch that lands in the tree during a session: `script` transcripts,
# clipboard dumps, editor and OS noise.
typescript
clipboard*
*.swp
*.swo
*~
.DS_Store
